---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { useT, type Lang } from '../i18n/ui';
import { page } from '../lib/url';
import { featured } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<Base lang={lang} route="/">
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1>{t('home.title')}</h1>
      <p class="intro">{t('home.intro')}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={page(lang, '/work/')}>{t('home.cta.primary')} <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="btn" href={page(lang, '/about/')}>{t('home.cta.secondary')}</a>
      </div>
    </div>
    <div class="hero-media">
      <!-- TODO: replace with Sitan's own rocket launch photo (src/assets/home/rocket-hero.jpg) -->
      <div class="placeholder" role="img" aria-label={`TODO: ${t('home.hero.todo')}`}>
        <span><strong>TODO</strong><br />{t('home.hero.todo')}</span>
      </div>
    </div>
  </section>

  <section class="selected wrap" aria-labelledby="selected-title">
    <div class="section-head">
      <h2 id="selected-title">{t('home.selected')}</h2>
      <a class="text-link" href={page(lang, '/work/')}>{t('home.viewAll')} <span aria-hidden="true">→</span></a>
    </div>
    <ul class="grid" role="list">
      {featured.map((p) => <li><ProjectCard project={p} lang={lang} /></li>)}
    </ul>
  </section>

  <section class="about wrap" aria-labelledby="about-title">
    <h2 id="about-title">{t('home.aboutTitle')}</h2>
    <div>
      <p class="measure">{t('home.aboutBody')}</p>
      <a class="text-link" href={page(lang, '/about/')}>{t('home.aboutCta')} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-5) var(--space-6);
  }
  @media (min-width: 56rem) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-5); min-height: calc(88vh - var(--header-h)); }
  }
  .hero-text { display: grid; gap: var(--space-3); justify-items: start; }
  .hero-text .eyebrow { margin: 0; }
  h1 { font-size: var(--step-3); }
  .intro { margin: 0; max-width: 52ch; color: var(--text); }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; padding-top: var(--space-1); }
  .hero-media .placeholder { aspect-ratio: 4 / 5; width: 100%; }
  @media (max-width: 55.99rem) { .hero-media .placeholder { aspect-ratio: 4 / 3; } }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }
  .section-head h2 { font-size: var(--step-2); }
  .grid {
    display: grid;
    gap: var(--space-5) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .about {
    display: grid;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 56rem) { .about { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .about h2 { font-size: var(--step-2); }
  .about p { margin: 0 0 var(--space-1); }
</style>
