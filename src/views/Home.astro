---
// Home page — copy from md文件/Sitan_Ding_Home_Claude_Brief_EN.md (sections A–D).
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { useT, contact, type Lang } from '../i18n/ui';
import { page } from '../lib/url';
import { featured } from '../data/projects';
import { Image } from 'astro:assets';
import rocket from '../assets/home/rocket-hero.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const cards = featured.slice(0, 4);
---

<Base lang={lang} route="/" footerCta={false}>
  <!-- A · Hero: split screen — centred text on the left, the photograph bleeding to the right edge -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1 id="hero-title">
        <span>{t('home.title1')}</span>
        <span class="line2">{t('home.title2')}</span>
      </h1>
      <p class="intro">{t('home.intro')}</p>
      <a class="btn btn-primary cta" href={page(lang, '/work/')}>{t('home.cta.primary')} <span class="arrow" aria-hidden="true">→</span></a>
      <ul class="social" role="list">
        {contact.linkedin && (
          <li><a href={contact.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm7 0h3.8v1.6h.06c.53-1 1.83-2.05 3.76-2.05 4.02 0 4.76 2.5 4.76 5.75V21h-4v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21h-4V9.75Z"/></svg>
          </a></li>
        )}
        {contact.facebook && (
          <li><a href={contact.facebook} target="_blank" rel="me noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.6h2.55l.4-3h-2.95V8.5c0-.86.25-1.45 1.5-1.45h1.6V4.37A21 21 0 0 0 14.27 4.2c-2.3 0-3.87 1.4-3.87 3.97v2.23H7.8v3h2.6V21h3.1Z"/></svg>
          </a></li>
        )}
        <li><a href={`mailto:${contact.email}`} aria-label={`${t('contact.email')}: ${contact.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18a1 1 0 0 1 1 1V18a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18V6.5a1 1 0 0 1 1-1Zm1 2.3v.2l8 5.3 8-5.3v-.2H4Z"/></svg>
        </a></li>
      </ul>
      <p class="credit eyebrow">{t('home.hero.caption')}</p>
    </div>
    <figure class="hero-media">
      <Image src={rocket} alt={t('home.hero.alt')} widths={[960, 1400, 2000]}
        sizes="(min-width: 56rem) 75vw, 150vw"
        loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <!-- B · Featured work -->
  <section class="selected wrap" id="selected" aria-labelledby="selected-title">
    <header class="section-head">
      <p class="eyebrow">{t('home.selected.eyebrow')}</p>
      <h2 id="selected-title">{t('home.selected')}</h2>
      <p class="lede">{t('home.selected.intro')}</p>
    </header>
    <ul class="grid" role="list">
      {cards.map((p, i) => <li><ProjectCard project={p} lang={lang} index={i + 1} /></li>)}
    </ul>
    <a class="text-link all" href={page(lang, '/work/')}>{t('home.viewAll')} <span class="arrow" aria-hidden="true">→</span></a>
  </section>

  <!-- C · Behind the work -->
  <section class="about wrap" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">{t('home.about.eyebrow')}</p>
      <h2 id="about-title">{t('home.aboutTitle')}</h2>
    </div>
    <div class="about-body">
      <p>{t('home.aboutBody1')}</p>
      <p>{t('home.aboutBody2')}</p>
      <a class="text-link" href={page(lang, '/about/')}>{t('home.aboutCta')} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- D · Contact -->
  <section class="contact wrap" aria-labelledby="contact-title">
    <h2 id="contact-title">{t('home.contact.title')}</h2>
    <p>{t('home.contact.body')}</p>
    <div class="contact-row">
      <a class="btn btn-primary" href={`mailto:${contact.email}`}>{t('home.contact.cta')} <span class="arrow" aria-hidden="true">↗</span></a>
      <a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </section>
</Base>

<style>
  /* A — split screen */
  .hero { display: grid; }
  .hero-text {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--gutter, 1.25rem);
    text-align: center;
  }
  .hero-text .eyebrow { margin: 0; }
  h1 { display: grid; gap: 0.35em; margin: 0; font-size: var(--step-3); }
  .line2 { font-size: 0.5em; line-height: 1.25; color: var(--text); font-weight: 500; }
  .intro { margin: 0; max-width: 54ch; color: var(--text-2); }
  .cta { margin-top: var(--space-2); border-radius: 999px; padding-inline: 1.6rem; }
  .social { display: flex; gap: 0.5rem; margin: var(--space-2) 0 0; padding: 0; list-style: none; }
  .social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--text); transition: background 0.2s ease-out; }
  .social a:hover { background: var(--sunken); }
  .social svg { width: 22px; height: 22px; fill: currentColor; }
  .credit { margin-top: var(--space-3) !important; font-size: 0.75rem; }
  .hero-media { position: relative; margin: 0; overflow: hidden; aspect-ratio: 4 / 5; container-type: size; }
  .hero-media img {
    /* The image box is the whole 3:2 photo at the frame's height (150cqh wide), centred in the frame. */
    position: absolute;
    top: 0;
    left: 50%;
    display: block;
    width: 150cqh;
    max-width: none;
    height: 100%;
    /* The rocket (nose to plume) is centred at 70.25% x / 51% y of the photo, i.e. 0.2025 × 150cqh =
       30.4cqh right of the photo's centre. Move it to the centre, zoom 1.5× there, then centre the box. */
    transform: translateX(-50%) scale(1.5) translate(-30.4cqh, -1.3cqh);
    transform-origin: 50% 50%;
  }
  @media (min-width: 56rem) {
    .hero { grid-template-columns: 1fr 1fr; min-height: calc(100svh - var(--header-h)); }
    .hero-text { padding-inline: clamp(1.5rem, 4vw, 4rem); }
    .hero-media { aspect-ratio: auto; height: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .social a { transition: none; } }

  /* B */
  .section-head { display: grid; gap: var(--space-2); max-width: 60ch; margin-bottom: var(--space-4); }
  .section-head .eyebrow { margin: 0; }
  .section-head h2, .about h2, .contact h2 { font-size: var(--step-2); }
  .lede { margin: 0; color: var(--text-2); }
  .grid { display: grid; gap: var(--space-5) var(--space-4); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .all { margin-top: var(--space-4); }

  /* C */
  .about {
    display: grid;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 56rem) { .about { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .about .eyebrow { margin: 0 0 var(--space-2); }
  .about h2 { max-width: 18ch; }
  .about-body { display: grid; gap: var(--space-2); justify-items: start; max-width: 60ch; }
  .about-body p { margin: 0; }

  /* D */
  .contact {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .contact p { margin: 0; max-width: 60ch; color: var(--text-2); }
  .contact-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-3); padding-top: var(--space-1); }
  .mail { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-2); overflow-wrap: anywhere; }
</style>
