---
// Scam Ready — bespoke project page (team project).
// Brief: md文件/3200/Scam_Ready_Claude_Portfolio_Brief_EN.md · Layout: DESIGN.md (paired rows; text-only = full width).
// Screens are extracted from the team's final report; the live prototype is the supplied Figma embed.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Zoom from '../../components/Zoom.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import Lightbox from '../../components/Lightbox.astro';
import { useT, type Lang } from '../../i18n/ui';
import { page } from '../../lib/url';
import { nextOf } from '../../data/projects';
import { copy as c, figma, team } from '../../data/scam-ready';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const next = nextOf('scam-ready');

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/scam-ready/*.jpg', { eager: true });
const img = (key: string): ImageMetadata => {
  const f = files[`../../assets/scam-ready/${key}.jpg`];
  if (!f) throw new Error(`Missing Scam Ready image: ${key}`);
  return f.default;
};
const stageImgs = c.flow.stages.map((s) => img(s.key));
const slides = (list: { key: string; alt: string; caption: string }[]) => list.map((m) => ({ src: img(m.key), alt: m.alt, caption: m.caption }));
---

<Base lang={lang} route="/work/scam-ready/" title="Scam Ready" description={c.hero.tagline} image={img('hero-landing')} theme="scam">
  <article lang="en" class="project scam">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <ol role="list">
        <li><a href={page(lang, '/work/')}>{t('nav.work')}</a></li>
        <li aria-current="page">Scam Ready</li>
      </ol>
      {lang === 'zh' && <p class="en-only" lang="zh-CN">{t('project.enOnly')}</p>}
    </nav>

    <!-- Hero: text | final landing screen -->
    <header class="wrap row hero">
      <div class="prose">
        <p class="eyebrow">{c.hero.eyebrow}</p>
        <h1>{c.hero.title}</h1>
        <p class="tagline">{c.hero.tagline}</p>
        <p class="sub">{c.hero.sub}</p>
        {c.hero.body.map((p) => <p>{p}</p>)}
        <div class="ctas">
          <a class="btn btn-primary" href="#prototype">{c.hero.ctaPrimary} <span aria-hidden="true">↓</span></a>
          <a class="btn" href="#development">{c.hero.ctaSecondary}</a>
        </div>
      </div>
      <Zoom src={img('hero-landing')} alt={c.hero.imageAlt} caption={c.hero.imageCaption} loading="eager" sizes="(min-width: 48rem) 680px, 100vw" />
    </header>
    <dl class="wrap details">{c.hero.details.map((d) => <div><dt>{d.k}</dt><dd>{d.v}</dd></div>)}</dl>

    <!-- 01 Challenge: text | figures + credibility chain -->
    <section class="wrap block row sticky" aria-labelledby="ch-h">
      <div class="prose">
        <p class="eyebrow">{c.challenge.eyebrow}</p>
        <h2 id="ch-h">{c.challenge.title}</h2>
        {c.challenge.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="stack media">
        <div class="stats two">
          {c.challenge.stats.map((s) => <div><p class="stat-v">{s.v}</p><p class="stat-k">{s.k}</p></div>)}
        </div>
        <p class="small muted">{c.challenge.statsSource}</p>
        <h3>{c.challenge.cuesTitle}</h3>
        <ol class="chain" role="list">
          {c.challenge.cues.map((q, i) => (
            <li><span class="num">{String(i + 1).padStart(2, '0')}</span><strong>{q.k}</strong><span>{q.v}</span></li>
          ))}
        </ol>
        <p class="question"><span class="num">The design question</span>{c.challenge.question}</p>
      </div>
    </section>

    <!-- 02 Personal motivation: text only → full width -->
    <section class="wrap block wide-text" aria-labelledby="me-h">
      <p class="eyebrow">{c.personal.eyebrow}</p>
      <h2 id="me-h">{c.personal.title}</h2>
      <div class="cols">{c.personal.body.map((p) => <p>{p}</p>)}</div>
      <ol class="timeline" role="list">
        {c.personal.timeline.map((e) => <li><p class="num">{e.label}</p><h3>{e.title}</h3><p>{e.text}</p></li>)}
      </ol>
      <p class="caveat"><span class="tag">Note</span>{c.personal.note}</p>
    </section>

    <!-- 03 Research: findings | charts, then insights full width -->
    <section class="wrap block" aria-labelledby="rs-h">
      <div class="row sticky">
        <div class="prose">
          <p class="eyebrow">{c.research.eyebrow}</p>
          <h2 id="rs-h">{c.research.title}</h2>
          <p>{c.research.intro}</p>
          <h3>{c.research.findingsTitle}</h3>
          <ul class="findings" role="list">
            {c.research.findings.map((f) => (
              <li>
                <p class="fig">{f.fig}</p>
                <p class="sample">{f.sample}</p>
                <p>{f.text}</p>
                <p class="means">{f.means}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="stack media">
          {c.research.charts.map((ch) => <Zoom src={img(ch.key)} alt={ch.alt} caption={ch.caption} sizes="(min-width: 48rem) 540px, 100vw" />)}
          <p class="caveat"><span class="tag">Evidence</span>{c.research.evidenceNote}</p>
        </div>
      </div>
      <div class="wide-text insights">
        <h3>{c.research.insightsTitle}</h3>
        <ol class="cards three" role="list">{c.research.insights.map((x) => <li><h4>{x.k}</h4><p>{x.v}</p></li>)}</ol>
        <div class="opp">
          <div><h3>{c.research.opportunityTitle}</h3><p>{c.research.opportunity}</p></div>
          <div><h3>{c.research.hmwTitle}</h3><blockquote>{c.research.hmw}</blockquote></div>
        </div>
      </div>
    </section>

    <!-- 04 Principles: screen | text -->
    <section class="wrap block row flip sticky" aria-labelledby="pr-h">
      <div class="prose">
        <p class="eyebrow">{c.principles.eyebrow}</p>
        <h2 id="pr-h">{c.principles.title}</h2>
        {c.principles.body.map((p) => <p>{p}</p>)}
        <ol class="plain" role="list">{c.principles.list.map((x) => <li><h4>{x.k}</h4><p>{x.v}</p></li>)}</ol>
      </div>
      <Zoom class="media" src={img(c.principles.image.key)} alt={c.principles.image.alt} caption={c.principles.image.caption} sizes="(min-width: 48rem) 560px, 100vw" />
    </section>

    <!-- 05 Solution + routine (full width), then the branching flow diagram -->
    <section class="wrap block" aria-labelledby="so-h">
      <div class="wide-text">
        <p class="eyebrow">{c.solution.eyebrow}</p>
        <h2 id="so-h">{c.solution.title}</h2>
        <div class="cols">{c.solution.body.map((p) => <p>{p}</p>)}</div>
        <h3>{c.solution.routineTitle}</h3>
        <ol class="routine" role="list">
          {c.solution.routine.map((r, i) => <li><span class="step">{r.k}</span><p>{r.v}</p>{i < 3 && <span class="arrow-r" aria-hidden="true">→</span>}</li>)}
        </ol>
        <p class="muted">{c.solution.routineNote}</p>
      </div>

      <div class="flow" data-flow>
        <div class="flow-head">
          <h3>{c.flow.title}</h3>
          <p class="small muted">{c.flow.hint}</p>
        </div>
        <div class="flow-map" role="group" aria-label={c.flow.title}>
          {[[0], [1], [2, 3], [4], [5]].map((col, ci) => (
            <div class:list={['flow-col', { branch: col.length > 1 }]}>
              {col.map((i) => {
                const s = c.flow.stages[i];
                return (
                  <button type="button" data-stage={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="flow-panel">
                    {s.branch && <span class="br">{s.branch}</span>}
                    {s.label}
                  </button>
                );
              })}
              {ci < 4 && <span class="flow-arrow" aria-hidden="true">→</span>}
            </div>
          ))}
        </div>
        <div id="flow-panel" class="flow-panel" aria-live="polite">
          {c.flow.stages.map((s, i) => (
            <div class="row flow-item" data-panel={i} hidden={i !== 0}>
              <div class="prose"><p class="num">{String(i + 1).padStart(2, '0')}</p><h4>{s.label}</h4><p>{s.text}</p></div>
              <Image src={stageImgs[i]} alt={s.alt} widths={[480, 900]} sizes="(min-width: 48rem) 540px, 100vw" />
            </div>
          ))}
        </div>
        <p class="small muted">{c.flow.note}</p>
      </div>
    </section>

    <!-- Live prototype: full width, playable in the page -->
    <section id="prototype" class="wrap block" aria-labelledby="pt-h">
      <div class="wide-text">
        <p class="eyebrow">{c.prototype.eyebrow}</p>
        <h2 id="pt-h">{c.prototype.title}</h2>
        <div class="cols">{c.prototype.body.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="figma-embed">
        <!-- Direct embed: scale the complete prototype to fit the available viewport. -->
        <iframe class="figma-frame" title={c.prototype.iframeTitle} width="800" height="450" src={figma.embed} allowfullscreen></iframe>
      </div>
      <div class="embed-foot">
        <a class="btn btn-primary" href={figma.direct} target="_blank" rel="noopener noreferrer">{c.prototype.open} <span class="arrow" aria-hidden="true">↗</span></a>
        <p class="small muted"><em>{c.prototype.note}</em> {c.prototype.blocked}</p>
      </div>
    </section>

    <!-- 06 Scenario 1: text | 2×2 screens -->
    <section class="wrap block row sticky" aria-labelledby="s1-h">
      <div class="prose">
        <p class="eyebrow">{c.scenario1.eyebrow}</p>
        <h2 id="s1-h">{c.scenario1.title}</h2>
        {c.scenario1.body.map((p) => <p>{p}</p>)}
        <ol class="plain" role="list">{c.scenario1.steps.map((x) => <li><h4>{x.k}</h4><p>{x.v}</p></li>)}</ol>
        <p class="caveat"><span class="tag">Fictional</span>{c.scenario1.fiction}</p>
      </div>
      <div class="media">
        <PhotoCarousel slides={slides(c.scenario1.images)} label="Scenario 1 screens" ratio="3 / 2" tone="light" zoom
          sizes="(min-width: 48rem) 560px, 100vw" prevLabel="Previous screen" nextLabel="Next screen" />
      </div>
    </section>

    <!-- 07 Replay & Rewind: screens | text -->
    <section class="wrap block row flip sticky" aria-labelledby="rp-h">
      <div class="prose">
        <p class="eyebrow">{c.replay.eyebrow}</p>
        <h2 id="rp-h">{c.replay.title}</h2>
        {c.replay.body.map((p) => <p>{p}</p>)}
        <h3>{c.replay.twoTitle}</h3>
        <ol class="plain" role="list">{c.replay.two.map((x) => <li><h4>{x.k}</h4><p>{x.v}</p></li>)}</ol>
        <p>{c.replay.closing}</p>
      </div>
      <div class="stack media">
        {c.replay.images.map((m) => <Zoom src={img(m.key)} alt={m.alt} caption={m.caption} sizes="(min-width: 48rem) 560px, 100vw" />)}
      </div>
    </section>

    <!-- 08 Routes: intro full width, then Foundation | Advanced columns, each with its own screens -->
    <section class="wrap block" aria-labelledby="ro-h">
      <div class="wide-text">
        <p class="eyebrow">{c.routes.eyebrow}</p>
        <h2 id="ro-h">{c.routes.title}</h2>
        <div class="cols">{c.routes.body.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="routes">
        {[c.routes.foundation, c.routes.advanced].map((r) => (
          <div class="route">
            <p class="when">{r.when}</p>
            <h3>{r.label}</h3>
            {r.text.map((p) => <p>{p}</p>)}
            <PhotoCarousel slides={slides(r.images)} label={`${r.label} screens`} ratio="3 / 2" tone="light" zoom
              sizes="(min-width: 48rem) 540px, 100vw" prevLabel="Previous screen" nextLabel="Next screen" />
          </div>
        ))}
      </div>
      <p class="routine-inline">Pause → Step Out → Verify → Decide</p>
      <p class="muted center">{c.routes.shared}</p>
    </section>

    <!-- 09 Verification X-Ray: text full width, then the signature screen large -->
    <section class="wrap block" aria-labelledby="xr-h">
      <div class="wide-text">
        <p class="eyebrow">{c.xray.eyebrow}</p>
        <h2 id="xr-h">{c.xray.title}</h2>
        <div class="cols">{c.xray.body.map((p) => <p>{p}</p>)}</div>
        <dl class="defs two">{c.xray.defs.map((d) => <div><dt>{d.k}</dt><dd>{d.v}</dd></div>)}</dl>
      </div>
      <Zoom class="xray-img" src={img(c.xray.image.key)} alt={c.xray.image.alt} caption={c.xray.image.caption} sizes="(min-width: 60rem) 905px, 100vw" widths={[600, 905, 1400]} />
      <div class="wide-text xray-after">
        <p>{c.xray.after}</p>
        <blockquote>{c.xray.question}</blockquote>
      </div>
    </section>

    <!-- 10 Feedback: screens | text -->
    <section class="wrap block row flip sticky" aria-labelledby="fb-h">
      <div class="prose">
        <p class="eyebrow">{c.feedback.eyebrow}</p>
        <h2 id="fb-h">{c.feedback.title}</h2>
        {c.feedback.body.map((p) => <p>{p}</p>)}
        <ol class="layers" role="list">{c.feedback.layers.map((l, i) => <li><span class="num">{i + 1}</span><span><strong>{l.k}</strong> — {l.v}</span></li>)}</ol>
        <p>{c.feedback.closing}</p>
      </div>
      <div class="stack media">
        {c.feedback.images.map((m) => <Zoom src={img(m.key)} alt={m.alt} caption={m.caption} sizes="(min-width: 48rem) 560px, 100vw" />)}
      </div>
    </section>

    <!-- 11 Scenario 2: text | screens -->
    <section class="wrap block row sticky" aria-labelledby="s2-h">
      <div class="prose">
        <p class="eyebrow">{c.scenario2.eyebrow}</p>
        <h2 id="s2-h">{c.scenario2.title}</h2>
        {c.scenario2.body.map((p) => <p>{p}</p>)}
        <h3>{c.scenario2.practiseTitle}</h3>
        <ul class="ticks">{c.scenario2.practise.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="media">
        <PhotoCarousel slides={slides(c.scenario2.images)} label="Scenario 2 screens" ratio="3 / 2" tone="light" zoom
          sizes="(min-width: 48rem) 560px, 100vw" prevLabel="Previous screen" nextLabel="Next screen" />
      </div>
    </section>

    <!-- 12 Future: screen | text + loop -->
    <section class="wrap block row flip sticky" aria-labelledby="fu-h">
      <div class="prose">
        <p class="eyebrow">{c.future.eyebrow}</p>
        <h2 id="fu-h">{c.future.title}</h2>
        {c.future.body.map((p) => <p>{p}</p>)}
        <ol class="loop" role="list">{c.future.loop.map((x) => <li>{x}</li>)}</ol>
        <p class="caveat"><span class="tag">Proposed</span>{c.future.caveat}</p>
      </div>
      <Zoom class="media" src={img(c.future.image.key)} alt={c.future.image.alt} caption={c.future.image.caption} sizes="(min-width: 48rem) 560px, 100vw" />
    </section>

    <!-- 13 Development: text | sketches, then what changed + before/after -->
    <section id="development" class="wrap block" aria-labelledby="dv-h">
      <div class="row sticky">
        <div class="prose">
          <p class="eyebrow">{c.development.eyebrow}</p>
          <h2 id="dv-h">{c.development.title}</h2>
          {c.development.body.map((p) => <p>{p}</p>)}
        </div>
        <Zoom class="media" src={img(c.development.sketch.key)} alt={c.development.sketch.alt} caption={c.development.sketch.caption} sizes="(min-width: 48rem) 560px, 100vw" />
      </div>
      <div class="wide-text changes">
        <h3>{c.development.changesTitle}</h3>
        <ol class="cards three" role="list">
          {c.development.changes.map((ch) => (
            <li>
              <h4>{ch.topic}</h4>
              <p class="vlabel">Earlier prototype</p><p>{ch.before}</p>
              <p class="vlabel final">Final revised design</p><p>{ch.after}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="ba">
        <Zoom src={img(c.development.compare.before.key)} alt={c.development.compare.before.alt} caption={c.development.compare.before.caption} sizes="(min-width: 48rem) 540px, 100vw" />
        <span class="ba-arrow" aria-hidden="true">→</span>
        <Zoom src={img(c.development.compare.after.key)} alt={c.development.compare.after.alt} caption={c.development.compare.after.caption} sizes="(min-width: 48rem) 540px, 100vw" />
      </div>
      <p class="caveat"><span class="tag">Not yet tested</span>{c.development.untested}</p>
    </section>

    <!-- 14 Testing: text + stats | tested screen, then findings full width -->
    <section class="wrap block" aria-labelledby="ts-h">
      <div class="row sticky">
        <div class="prose">
          <p class="eyebrow">{c.testing.eyebrow}</p>
          <h2 id="ts-h">{c.testing.title}</h2>
          {c.testing.body.map((p) => <p>{p}</p>)}
          <div class="stats three">{c.testing.stats.map((s) => <div><p class="stat-v">{s.v}</p><p class="stat-k">{s.k}</p><p class="small muted">{s.d}</p></div>)}</div>
          <p class="caveat"><span class="tag">SUS</span>{c.testing.susNote}</p>
        </div>
        <Zoom class="media" src={img(c.testing.image.key)} alt={c.testing.image.alt} caption={c.testing.image.caption} sizes="(min-width: 48rem) 560px, 100vw" />
      </div>
      <div class="wide-text">
        <h3>{c.testing.revealedTitle}</h3>
        <ol class="cards three" role="list">{c.testing.revealed.map((x) => <li><h4>{x.k}</h4><p>{x.v}</p></li>)}</ol>
        <p class="muted">{c.testing.closing}</p>
      </div>
    </section>

    <!-- 15 Response: text only → full width table -->
    <section class="wrap block wide-text" aria-labelledby="re-h">
      <p class="eyebrow">{c.response.eyebrow}</p>
      <h2 id="re-h">{c.response.title}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">What testing revealed</th><th scope="col">Design response</th></tr></thead>
          <tbody>{c.response.rows.map((r) => <tr><td>{r.found}</td><td>{r.response}</td></tr>)}</tbody>
        </table>
      </div>
      <h3>{c.response.stillTitle}</h3>
      <ul class="ticks cols-list">{c.response.still.map((x) => <li>{x}</li>)}</ul>
      <p class="caveat"><span class="tag">Evidence</span>{c.response.note}</p>
    </section>

    <!-- 16 Impact: full width, three columns -->
    <section class="wrap block wide-text" aria-labelledby="im-h">
      <p class="eyebrow">{c.impact.eyebrow}</p>
      <h2 id="im-h">{c.impact.title}</h2>
      <p>{c.impact.body}</p>
      <div class="impact">
        <div><h3>Built</h3><ul class="ticks">{c.impact.built.map((x) => <li>{x}</li>)}</ul></div>
        <div><h3>Not yet established</h3><ul class="ticks">{c.impact.notYet.map((x) => <li>{x}</li>)}</ul></div>
        <div><h3>Next evaluation</h3><ol class="plain" role="list">{c.impact.next.map((x) => <li><h4>{x.k}</h4><p>{x.v}</p></li>)}</ol></div>
      </div>
    </section>

    <!-- 17 Team + contribution -->
    <section class="wrap block wide-text" aria-labelledby="tm-h">
      <p class="eyebrow">{c.contribution.eyebrow}</p>
      <h2 id="tm-h">{c.contribution.title}</h2>
      <p>{c.contribution.body}</p>
      <p><strong>Team:</strong> {team.join(' · ')}</p>
      <h3>My contribution</h3>
      <dl class="defs contrib">
        {c.contribution.mine.map((m) => <div><dt>{m.k}</dt><dd>{m.v ?? <span class="todo-inline">{c.contribution.pending}</span>}</dd></div>)}
      </dl>
    </section>

    <!-- 18 Sources -->
    <section class="wrap block wide-text sources" aria-labelledby="src-h">
      <h2 id="src-h" class="small-h2">References</h2>
      <ul>{c.references.map((r) => <li>{r.text} <a href={r.url} target="_blank" rel="noopener">{r.url.replace('https://', '')}</a></li>)}</ul>
      <p>{c.researchData}</p>
      <h3>AI acknowledgement</h3>
      <p>{c.ai}</p>
    </section>

    <nav class="wrap bottom-nav" aria-label="Project navigation">
      <a class="text-link" href={page(lang, '/work/')}>← All Work</a>
      <a class="next" href={page(lang, `/work/${next.slug}/`)}>
        <span class="eyebrow">Next Project</span>
        <span class="next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
  <Lightbox />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-stage]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const order = buttons.map((b) => Number(b.dataset.stage));
    const show = (i: number) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.stage) === i)));
      panels.forEach((p) => (p.hidden = Number(p.dataset.panel) !== i));
    };
    buttons.forEach((b, idx) => {
      b.addEventListener('click', () => show(Number(b.dataset.stage)));
      b.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const n = buttons[(idx + (e.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length];
        n.focus();
        show(order[buttons.indexOf(n)]);
      });
    });
  });
</script>

<style>
  .crumbs { padding-top: var(--space-3); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; font-size: var(--step--1); color: var(--text-2); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; margin-block: -0.6rem; color: var(--text-2); }
  .en-only { margin-top: 0.5rem !important; font-size: var(--step--1); color: var(--text-2); }

