---
// Aerospace Stories — bilingual project page.
// Brief: md文件/火箭/Aerospace_Stories_Claude_Portfolio_Brief_EN_ZH.md · Layout: DESIGN.md
// (paired rows: each video sits beside its own text; text-only parts span the full width).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Zoom from '../../components/Zoom.astro';
import Lightbox from '../../components/Lightbox.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import { useT, type Lang } from '../../i18n/ui';
import { page, url } from '../../lib/url';
import { copy, videos, photos, platformName } from '../../data/aerospace-stories';
import hero from '../../assets/home/rocket-hero.jpg';
import tz9Cover from '../../assets/aerospace-stories/tz9-cover.webp';
import lunarCover from '../../assets/aerospace-stories/lunar-cover.webp';
import poster from '../../assets/aerospace-stories/footage-poster.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const t = useT(lang);
const covers: Record<string, ImageMetadata | undefined> = { 'tianzhou-9': tz9Cover, lunar: lunarCover };
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/aerospace-stories/photo-*.jpg', { eager: true });
const slides = photos.map((p) => ({
  src: files[`../../assets/aerospace-stories/${p.key}.jpg`].default,
  alt: lang === 'zh' ? p.altZh : p.altEn,
  caption: lang === 'zh' ? p.zh : p.en,
}));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base lang={lang} route="/work/aerospace-stories/" title="Aerospace Stories" description={c.tagline} image={hero}>
  <article class="project aerospace">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <a class="text-link" href={page(lang, '/work/')}>← {t('project.back')}</a>
    </nav>

    <!-- Hero: text | own photograph -->
    <header class="wrap row hero">
      <div class="prose">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>Aerospace Stories</h1>
        <p class="tagline">{c.tagline}</p>
        <p>{c.intro}</p>
        <div class="ctas"><a class="btn btn-primary" href="#videos">{c.videos} <span aria-hidden="true">↓</span></a></div>
      </div>
      <Zoom src={hero} alt={c.heroAlt} caption={c.personal} loading="eager" sizes="(min-width: 48rem) 560px, 100vw" />
    </header>
    <p class="wrap credit"><strong>{c.team}</strong><span>{c.credit}</span></p>

    <!-- 01 Videos: intro full width, then one paired row per video (player | text, alternating) -->
    <section id="videos" class="wrap block" aria-labelledby="videos-heading">
      <div class="wide-text">
        <p class="eyebrow">01</p>
        <h2 id="videos-heading">{c.videos}</h2>
        <p>{c.videosIntro}</p>
      </div>

      {videos.map((v, i) => {
        const cover = covers[v.id];
        const vertical = v.ratio === '1080 / 1920';
        return (
          <div class:list={['row', 'video-row', { flip: i % 2 === 1, sticky: vertical }]}>
            <div class:list={['prose', { pin: vertical }]}>
              <p class="eyebrow">{pad(i + 1)} / {platformName[lang][v.platform as 'Douyin' | 'Bilibili']}</p>
              <h3>{v.title[lang]}</h3>
              <p class="role"><span>{c.role}</span>{v.role[lang]}</p>
              <p>{v.description[lang]}</p>
              <a class="btn" href={v.url} target="_blank" rel="noopener noreferrer">
                {c.watch} {platformName[lang][v.platform as 'Douyin' | 'Bilibili']} <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class:list={['media', 'player-col', { vertical }]}>
              <div class="player" style={`aspect-ratio: ${v.ratio}`} data-player={v.player} data-title={v.title[lang]} data-douyin={v.platform === 'Douyin' ? '' : undefined}>
                {cover ? (
                  <Image class="video-poster" src={cover} alt="" widths={[560, 1100]} sizes="(min-width: 48rem) 560px, 100vw" />
                ) : (
                  <div class="poster-blank" aria-hidden="true"><span>{platformName[lang][v.platform as 'Douyin' | 'Bilibili']}</span></div>
                )}
                <button class="play" type="button" aria-label={`${c.play}: ${v.title[lang]}`}>
                  <span class="play-icon" aria-hidden="true">▶</span>{c.play}
                </button>
              </div>
            </div>
          </div>
        );
      })}
      <p class="small muted note">{c.fallback}</p>
    </section>

    <!-- 02 Own footage: text | native video -->
    <section class="wrap block row flip" aria-labelledby="footage-heading">
      <div class="prose">
        <p class="eyebrow">02 / {c.footageLabel}</p>
        <h2 id="footage-heading">{c.footage}</h2>
        <p>{c.footageBody}</p>
      </div>
      <div class="media">
        <video class="footage" controls playsinline preload="metadata" poster={poster.src} width={poster.width} height={poster.height} aria-label={c.footage}>
          <source src={url('/video/aerospace-stories/original-footage.mp4')} type="video/mp4" />
          <a href={url('/video/aerospace-stories/original-footage.mp4')}>{c.footage}</a>
        </video>
        <p class="small muted">{c.personal}</p>
      </div>
    </section>

    <!-- 03 Photography: text | carousel of own photographs -->
    <section class="wrap block row" aria-labelledby="gallery-heading">
      <div class="prose">
        <p class="eyebrow">03</p>
        <h2 id="gallery-heading">{c.gallery}</h2>
        <p>{c.galleryBody}</p>
        <p class="small muted">{slides.length + 1} {c.photoCount} · {c.personal}</p>
      </div>
      <div class="media">
        <PhotoCarousel slides={slides} label={c.gallery} ratio="3 / 2" zoom sizes="(min-width: 48rem) 600px, 100vw" />
      </div>
    </section>

    <!-- 04 Roles: text only → full width -->
    <section class="wrap block wide-text" aria-labelledby="role-heading">
      <p class="eyebrow">04</p>
      <h2 id="role-heading">{c.roles}</h2>
      <dl class="roles">
        {videos.map((v) => <div><dt>{v.title[lang]}</dt><dd>{v.role[lang]}</dd></div>)}
      </dl>
      <p class="muted">{c.credit}</p>
    </section>

    <!-- Closing: full width -->
    <section class="wrap block wide-text closing">
      <blockquote><p>{c.closing}</p></blockquote>
      <a class="text-link" href={page(lang, '/work/')}>← {t('project.back')}</a>
    </section>
  </article>
  <Lightbox />
</Base>

<script>
  // Click-to-load players (AGENTS.md: heavy embeds load only after a click).
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((stage) => {
    stage.querySelector('button')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = stage.dataset.player!;
      frame.title = stage.dataset.title!;
      frame.allowFullscreen = true;
      frame.setAttribute('allow', 'fullscreen; picture-in-picture');
      if (stage.dataset.douyin !== undefined) frame.referrerPolicy = 'unsafe-url';
      stage.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .crumbs { padding-top: var(--space-3); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; }
  .eyebrow { margin: 0; color: var(--accent); }

  .hero { padding-top: var(--space-2); }
  .hero h1 { font-size: var(--step-3); }
  .tagline { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .credit { display: grid; gap: 0.25rem; margin-top: var(--space-4); padding-block: var(--space-2); border-block: 1px solid var(--line); color: var(--text-2); font-size: var(--step--1); }
  .credit strong { color: var(--text); font-weight: 600; }

  /* Videos */
  .video-row { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--line); align-items: center; }
  .video-row h3 { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .role { display: grid; gap: 0.1rem; font-weight: 600; }
  .role span { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
  .player-col { min-width: 0; }
  .player-col.vertical { display: flex; justify-content: center; }
  .player-col.vertical .player { width: min(100%, 21rem); }
  .player { position: relative; width: 100%; overflow: hidden; border-radius: var(--radius); background: var(--dark); border: 1px solid var(--line); }
  .player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; border: 0; }
  .player :global(.video-poster) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .poster-blank { position: absolute; inset: 0; display: grid; place-items: start center; padding-top: 18%; color: var(--bg); opacity: 0.6; font-size: var(--step--1); letter-spacing: 0.08em; text-transform: uppercase; }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0 1.2rem 0 0.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.2s ease-out;
  }
  .play:hover { transform: translate(-50%, -50%) scale(1.04); }
  .play-icon { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--text); color: var(--bg); font-size: 0.75rem; padding-left: 2px; }
  .note { margin-top: var(--space-3) !important; }
  .video-row .btn { justify-self: start; }

  /* Footage */
  .footage { display: block; width: 100%; height: auto; border-radius: var(--radius); background: var(--dark); }
  .media .small { margin-top: 0.5rem; }

  /* Roles + closing */
  .roles { margin: 0; border-top: 1px solid var(--line); }
  .roles > div { display: flex; justify-content: space-between; gap: var(--space-3); padding-block: 0.85rem; border-bottom: 1px solid var(--line); }
  .roles dt { font-weight: 500; }
  .roles dd { margin: 0; color: var(--text-2); text-align: right; }
  .closing blockquote { margin: 0; padding-block: var(--space-3); border-block: 1px solid var(--line); }
  .closing blockquote p { font-size: clamp(1.35rem, 1.4vw + 1rem, 2rem); font-weight: 600; line-height: 1.3; letter-spacing: -0.015em; }

  @media (prefers-reduced-motion: reduce) { .play { transition: none; } }
  @media (max-width: 47.99rem) {
    .roles > div { flex-direction: column; gap: 0.25rem; }
    .roles dd { text-align: left; }
  }
</style>
