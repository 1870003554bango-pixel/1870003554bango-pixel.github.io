---
// Ocean Archive 2087 — bilingual case study.
// Briefs: md文件/3009genx/*.md · Layout: DESIGN.md (paired text | media rows; text-only blocks full width).
// Game images are real captures from the live Unity Web Player build (Acts 01–02). Acts 03–04 show labelled TODO boxes.
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Zoom from '../../components/Zoom.astro';
import Lightbox from '../../components/Lightbox.astro';
import { useT, type Lang } from '../../i18n/ui';
import { page, url } from '../../lib/url';
import divePoster from '../../assets/ocean-archive-2087/dive-poster.jpg';
import { nextOf } from '../../data/projects';
import { copy, demoUrl } from '../../data/ocean-archive-2087';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const t = useT(lang);
const next = nextOf('ocean-archive-2087');

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/ocean-archive-2087/*.jpg', { eager: true });
const img = (key: string): ImageMetadata => {
  const f = files[`../../assets/ocean-archive-2087/${key}.jpg`];
  if (!f) throw new Error(`Missing Ocean Archive image: ${key}`);
  return f.default;
};
const cap = c.capturedCaption;
const R = Object.fromEntries(c.interaction.rows.map((r) => [r.id, r])) as Record<string, any>;
const x = c.tech;
const dive = url('/video/ocean-archive-2087/dive.mp4');
const statusLabel: Record<string, string> = { fixed: c.iteration.fixed, partial: c.iteration.partial, open: c.iteration.open };
---

<Base lang={lang} route="/work/ocean-archive-2087/" title="Ocean Archive 2087" description={c.tagline} image={img('act1-reef')}>
  <article class="project oa">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <ol role="list">
        <li><a href={page(lang, '/work/')}>{t('nav.work')}</a></li>
        <li aria-current="page">Ocean Archive 2087</li>
      </ol>
    </nav>

    <!-- Hero: text | in-game reef -->
    <header class="wrap row hero">
      <div class="prose">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="tagline">{c.tagline}</p>
        <p>{c.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#origin">{c.ctaStory} <span aria-hidden="true">↓</span></a>
          <a class="btn" href="#play">{c.ctaPlay}</a>
          <a class="text-link" href="#tech">{c.ctaTech} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <Zoom src={img('act1-reef')} alt={c.heroAlt} caption={cap} loading="eager" widths={[640, 1100, 1920]} sizes="(min-width: 48rem) 600px, 100vw" />
    </header>
    <dl class="wrap details">{c.details.map((d) => <div><dt>{d.k}</dt><dd>{d.v}</dd></div>)}</dl>
    <nav class="wrap toc" aria-label={c.toc.label}>
      <p class="eyebrow">{c.toc.label}</p>
      <ol role="list">{c.toc.items.map((i) => <li><a href={`#${i.id}`}>{i.k}</a></li>)}</ol>
    </nav>

    <!-- 01 Origin: intro, four-stage timeline, then dive clip | personal connection -->
    <section id="origin" class="wrap block" aria-labelledby="or-h">
      <div class="wide-text">
        <p class="eyebrow num">{c.origin.eyebrow}</p>
        <h2 id="or-h">{c.origin.title}</h2>
        {c.origin.body.map((p) => <p>{p}</p>)}
      </div>
      <ol class="timeline" role="list">
        {c.origin.stages.map((s, i) => (
          <li class:list={{ current: i === 3 }}>
            <p class="tl-n"><span class="num">{String(i + 1).padStart(2, '0')}</span><span class="tl-tag">{s.tag}</span></p>
            <h3>{s.k}{i === 3 && <span class="tag mine">{c.origin.current}</span>}</h3>
            <p>{s.text}</p>
            {s.link && <a class="text-link" href={page(lang, s.link)}>{c.origin.seeProject} <span aria-hidden="true">→</span></a>}
            {s.q && <p class="tl-q"><span aria-hidden="true">↳ </span>{s.q}</p>}
          </li>
        ))}
      </ol>
      <div class="row flip dive">
        <div class="prose">
          <h3>{c.origin.diveTitle}</h3>
          {c.origin.diveBody.map((p) => <p>{p}</p>)}
        </div>
        <figure class="clip">
          <video controls playsinline muted preload="none" poster={divePoster.src} width="1920" height="1080" aria-label={c.origin.diveLabel}>
            <source src={dive} type="video/mp4" />
            <a href={dive}>{c.origin.diveLabel}</a>
          </video>
          <figcaption class="caveat"><span class="tag">{c.origin.diveTag}</span>{c.origin.diveCaption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 Design problem: text | five layers, then principles and evolution full width -->
    <section id="problem" class="wrap block" aria-labelledby="pr-h">
      <div class="row">
        <div class="prose">
          <p class="eyebrow num">{c.problem.eyebrow}</p>
          <h2 id="pr-h">{c.problem.title}</h2>
          {c.problem.body.map((p) => <p>{p}</p>)}
          <blockquote class="question"><p>{c.problem.question}</p></blockquote>
        </div>
        <div class="panel">
          <p class="eyebrow">{c.problem.layersTitle}</p>
          <ol class="layers" role="list">{c.problem.layers.map((l, i) => <li><span class="num">{i + 1}</span><div><p class="lk">{l.k}</p><p class="lv">{l.v}</p></div></li>)}</ol>
        </div>
      </div>
      <div class="two-tables">
        <div>
          <h3 class="sub-h">{c.problem.principlesTitle}</h3>
          <table>
            <thead><tr>{c.problem.principlesHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{c.problem.principles.map((r) => <tr><th scope="row">{r[0]}</th><td class="muted">{r[1]}</td></tr>)}</tbody>
          </table>
        </div>
        <div>
          <h3 class="sub-h">{c.problem.evolutionTitle}</h3>
          <p class="muted small">{c.problem.evolutionBody}</p>
          <div class="scroll">
            <table>
              <thead><tr>{c.problem.evolutionHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{c.problem.evolution.map((r) => <tr><td class="muted">{r[0]}</td><td>{r[1]}</td><td class="muted">{r[2]}</td></tr>)}</tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 Four acts: intro + flow, then one row per act (text | capture or TODO box) -->
    <section id="acts" class="wrap block" aria-labelledby="ac-h">
      <div class="wide-text">
        <p class="eyebrow num">{c.acts.eyebrow}</p>
        <h2 id="ac-h">{c.acts.title}</h2>
        <p>{c.acts.body}</p>
      </div>
      <ol class="flow" role="list">{c.acts.flow.map((f) => <li>{f}</li>)}</ol>
      {c.acts.list.map((a, i) => (
        <div class:list={['row', 'act', { flip: i % 2 === 1 }]}>
          <div class="prose">
            <p class="num">{a.n}</p>
            <h3>{a.k}</h3>
            <p class="mood">{a.mood}</p>
            <p>{a.text}</p>
            <p class="system"><span class="tag">{lang === 'zh' ? '代表系统' : 'Key system'}</span>{a.system}</p>
          </div>
          {a.img ? (
            <Zoom src={img(a.img)} alt={a.alt} caption={a.note ? `${cap} ${a.note}` : cap} widths={[640, 1100, 1920]} sizes="(min-width: 48rem) 560px, 100vw" />
          ) : (
            <div class="todo" role="note"><span class="tag">TODO</span><p>{i === 2 ? c.acts.todoAct3 : c.acts.todoAct4}</p></div>
          )}
        </div>
      ))}
      <p class="ending">{c.acts.ending}</p>
    </section>

    <!-- 04 Core interaction: loop, then paired rows -->
    <section id="interaction" class="wrap block" aria-labelledby="in-h">
      <div class="wide-text">
        <p class="eyebrow num">{c.interaction.eyebrow}</p>
        <h2 id="in-h">{c.interaction.title}</h2>
        <p>{c.interaction.body}</p>
      </div>
      <ol class="loop" role="list">{c.interaction.loop.map((l, i) => <li><span class="num">{String(i + 1).padStart(2, '0')}</span>{l}</li>)}</ol>

      <div class="row detail">
        <div class="prose">
          <p class="num">{R.scan.n}</p><h3>{R.scan.k}</h3><p>{R.scan.v}</p>
          <p class="formula"><code>{R.scan.formula}</code></p>
          <p class="small muted">{R.scan.formulaNote}</p>
        </div>
        <Zoom src={img(R.scan.img)} alt={R.scan.alt} caption={cap} widths={[640, 1100, 1920]} sizes="(min-width: 48rem) 560px, 100vw" />
      </div>

      <div class="row flip sticky detail">
        <div class="prose"><p class="num">{R.bag.n}</p><h3>{R.bag.k}</h3><p>{R.bag.v}</p></div>
        <div class="media pair">
          <figure><Zoom src={img(R.bag.img)} alt={R.bag.alt} caption={cap} widths={[640, 1100]} sizes="(min-width: 48rem) 560px, 100vw" /><span class="pair-k">{R.bag.cap}</span></figure>
          <figure><Zoom src={img(R.bag.img2)} alt={R.bag.alt2} caption={cap} widths={[640, 1100]} sizes="(min-width: 48rem) 560px, 100vw" /><span class="pair-k">{R.bag.cap2}</span></figure>
        </div>
      </div>

      <div class="row detail">
        <div class="prose"><p class="num">{R.hunger.n}</p><h3>{R.hunger.k}</h3><p>{R.hunger.v}</p></div>
        <div class="panel">
          <table>
            <thead><tr>{R.hunger.tableHead.map((h: string) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{R.hunger.table.map((r: string[]) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td></tr>)}</tbody>
          </table>
          <p class="small muted">{x.documented}</p>
        </div>
      </div>

      <div class="row flip detail">
        <div class="prose"><p class="num">{R.net.n}</p><h3>{R.net.k}</h3><p>{R.net.v}</p></div>
        <Zoom src={img('act2-arrival')} alt={c.acts.list[1].alt} caption={cap} widths={[640, 1100, 1920]} sizes="(min-width: 48rem) 560px, 100vw" />
      </div>

      <div class="row detail">
        <div class="prose"><p class="num">{R.guide.n}</p><h3>{R.guide.k}</h3><p>{R.guide.v}</p></div>
        <Zoom src={img(R.guide.img)} alt={R.guide.alt} caption={cap} widths={[640, 1100, 1920]} sizes="(min-width: 48rem) 560px, 100vw" />
      </div>

      <div class="wide-text detail">
        <p class="num">{R.record.n}</p><h3>{R.record.k}</h3><p>{R.record.v}</p>
      </div>
    </section>

    <!-- 05 Technical highlights -->
    <section id="tech" class="wrap block" aria-labelledby="te-h">
      <div class="wide-text">
        <p class="eyebrow num">{x.eyebrow}</p>
        <h2 id="te-h">{x.title}</h2>
        <p>{x.body}</p>
        <p class="caveat"><span class="tag">{lang === 'zh' ? '文档记录' : 'Documented'}</span>{x.documented}</p>
      </div>

      <!-- 05A current -->
      <div class="row sticky detail">
        <div class="prose">
          <p class="num">{x.current.n}</p><h3>{x.current.k}</h3>
          {x.current.v.map((p) => <p>{p}</p>)}
          <p class="formula"><code>{x.current.formula}</code></p>
        </div>
        <div class="media">
          <div class="panel">
            <table>
              <thead><tr>{x.current.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{x.current.rows.map((r) => <tr><th scope="row">{r[0]}</th><td class="num-v">{r[1]}</td></tr>)}</tbody>
            </table>
          </div>
          <div class="panel">
            <p class="lk">{x.current.modTitle}</p>
            <p class="small muted">{x.current.mod}</p>
          </div>
        </div>
      </div>

      <!-- 05B fish -->
      <div class="row flip sticky detail">
        <div class="prose">
          <p class="num">{x.flock.n}</p><h3>{x.flock.k}</h3>
          {x.flock.v.map((p) => <p>{p}</p>)}
          <p class="formula"><code>{x.flock.formula}</code></p>
          <p class="small muted">{x.flock.formulaNote}</p>
          <ol class="states" role="list">{x.flock.states.map((s) => <li>{s}</li>)}</ol>
          <p class="small muted">{x.flock.limit}</p>
        </div>
        <div class="media">
          <Zoom src={img(x.flock.img)} alt={x.flock.alt} caption={cap} widths={[640, 1100, 1920]} sizes="(min-width: 48rem) 560px, 100vw" />
          <table>
            <thead><tr>{x.flock.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.flock.rows.map((r) => <tr><th scope="row">{r[0]}</th><td class="num-v">{r[1]}</td></tr>)}</tbody>
          </table>
        </div>
      </div>

      <!-- 05C light -->
      <div class="row sticky detail">
        <div class="prose">
          <p class="num">{x.light.n}</p><h3>{x.light.k}</h3>
          {x.light.v.map((p) => <p>{p}</p>)}
          <table>
            <thead><tr>{x.light.layersHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.light.layers.map((r) => <tr><th scope="row">{r[0]}</th><td class="muted">{r[1]}</td></tr>)}</tbody>
          </table>
        </div>
        <div class="media">
          <figure class="cmp">
            <Zoom src={img(x.light.cmpA)} alt={x.light.cmpAAlt} caption={x.light.cmpACap} widths={[640, 1100]} sizes="(min-width: 48rem) 560px, 100vw" />
            <Zoom src={img(x.light.cmpB)} alt={x.light.cmpBAlt} caption={x.light.cmpBCap} widths={[640, 1100]} sizes="(min-width: 48rem) 560px, 100vw" />
          </figure>
          <table>
            <thead><tr>{x.light.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.light.rows.map((r) => <tr><th scope="row">{r[0]}</th><td class="num-v">{r[1]}</td><td class="num-v">{r[2]}</td></tr>)}</tbody>
          </table>
        </div>
      </div>

      <!-- 05D spire -->
      <div class="row flip detail">
        <div class="prose">
          <p class="num">{x.spire.n}</p><h3>{x.spire.k}</h3>
          {x.spire.v.map((p) => <p>{p}</p>)}
          <ol class="states" role="list">{x.spire.flow.map((s) => <li>{s}</li>)}</ol>
        </div>
        <div class="media">
          <div class="todo small-todo" role="note"><span class="tag">TODO</span><p>{c.acts.todoAct4}</p></div>
          <table>
            <thead><tr>{x.spire.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.spire.rows.map((r) => <tr><th scope="row">{r[0]}</th><td class="muted">{r[1]}</td><td class="num-v">{r[2]}</td></tr>)}</tbody>
          </table>
        </div>
      </div>

      <details class="appendix">
        <summary>{x.appendixTitle}</summary>
        <div class="app-grid">
          {x.appendix.map((g) => <div><p class="lk">{g.g}</p><ul>{g.items.map((it) => <li>{it}</li>)}</ul></div>)}
        </div>
      </details>
    </section>

    <!-- 06 Try it: click-to-load Unity Web Player -->
    <section id="play" class="wrap block" aria-labelledby="pl-h">
      <div class="wide-text">
        <p class="eyebrow num">{c.play.eyebrow}</p>
        <h2 id="pl-h">{c.play.title}</h2>
        <p>{c.play.body}</p>
      </div>
      <figure class="unity" data-unity data-src={demoUrl} data-title="Ocean Archive 2087 — Interactive Unity Experience">
        <div class="stage">
          <img src={img('act1-start').src} alt={c.play.posterAlt} loading="lazy" decoding="async" />
          <button type="button" class="btn btn-primary run"><span aria-hidden="true">▶</span>{c.play.load}</button>
        </div>
      </figure>
      <div class="play-row">
        <dl class="controls">{c.play.controls.map((k) => <div><dt><kbd>{k.k}</kbd></dt><dd>{k.v}</dd></div>)}</dl>
        <a class="btn" href={demoUrl} target="_blank" rel="noopener noreferrer">{c.play.open} <span aria-hidden="true">↗</span></a>
      </div>
      <p class="small muted">{c.play.note}</p>
    </section>

    <!-- 07 Iteration -->
    <section id="iteration" class="wrap block wide-text" aria-labelledby="it-h">
      <p class="eyebrow num">{c.iteration.eyebrow}</p>
      <h2 id="it-h">{c.iteration.title}</h2>
      <div class="scroll">
        <table class="issues">
          <thead><tr>{c.iteration.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {c.iteration.rows.map((r) => (
              <tr><td>{r.k}</td><td class="muted">{r.v}</td><td><span class:list={['status', r.s]}><span aria-hidden="true">{r.s === 'fixed' ? '✓' : r.s === 'partial' ? '◐' : '○'}</span>{statusLabel[r.s]}</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted">{c.iteration.note}</p>
    </section>

    <!-- 08 Reflection -->
    <section id="reflection" class="wrap block wide-text" aria-labelledby="re-h">
      <p class="eyebrow num">{c.reflection.eyebrow}</p>
      <h2 id="re-h">{c.reflection.title}</h2>
      {c.reflection.body.map((p) => <p>{p}</p>)}
    </section>

    <!-- 09 Credits -->
    <section class="wrap block wide-text credits" aria-labelledby="cr-h">
      <p class="eyebrow num">{c.credits.eyebrow}</p>
      <h2 id="cr-h">{c.credits.title}</h2>
      <p>{c.credits.role}</p>
      <p>{c.credits.ai}</p>
      <p class="muted">{c.credits.imagesNote}</p>
      <details>
        <summary>{c.credits.assetsSummary}</summary>
        <ul>{c.credits.assets.map((a) => <li>{a}</li>)}</ul>
        <p class="small muted">{c.credits.assetsNote}</p>
      </details>
    </section>

    <nav class="wrap bottom-nav" aria-label={lang === 'zh' ? '项目导航' : 'Project navigation'}>
      <a class="text-link" href={page(lang, '/work/')}>← {t('project.back')}</a>
      <a class="next" href={page(lang, `/work/${next.slug}/`)}>
        <span class="eyebrow">{t('project.next')}</span>
        <span class="next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
  <Lightbox />
</Base>

<script>
  // Load the Unity Web Player only when asked.
  document.querySelectorAll<HTMLElement>('[data-unity]').forEach((fig) => {
    fig.querySelector('.run')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = fig.dataset.src!;
      frame.title = fig.dataset.title!;
      frame.allow = 'autoplay; fullscreen; gamepad; xr-spatial-tracking; pointer-lock';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      fig.querySelector('.stage')!.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .crumbs { padding-top: var(--space-3); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; font-size: var(--step--1); color: var(--text-2); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; margin-block: -0.6rem; color: var(--text-2); }

  .oa .eyebrow.num { color: var(--accent); font-weight: 600; }
  .oa h3 { font-size: var(--step-1); }
  .oa .num { color: var(--accent); font-weight: 600; }
  .sub-h { margin-top: 0; }
  .hero { padding-top: var(--space-2); }
  .hero h1 { font-size: var(--step-3); }
  .tagline { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .ctas { display: flex; gap: 0.75rem 1rem; flex-wrap: wrap; align-items: center; }
  .ctas .text-link { display: inline-flex; align-items: center; min-height: 44px; }
  .details { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.6rem var(--space-3); margin-top: var(--space-4); padding-block: var(--space-2); border-block: 1px solid var(--line); }
  .details dt { font-size: var(--step--1); color: var(--text-2); }
  .details dd { margin: 0; font-size: var(--step--1); font-weight: 500; }
  .toc { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem var(--space-3); margin-top: var(--space-2); }
  .toc .eyebrow { margin: 0; color: var(--text-2); }
  .toc ol { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin: 0; padding: 0; list-style: none; }
  .toc a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--step--1); font-weight: 500; color: var(--text); text-decoration: none; }
  .toc a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .caveat { display: flex; gap: 0.6rem; align-items: baseline; margin: 0; font-size: var(--step--1); color: var(--text-2); }
  .tag { flex: none; padding: 0.1rem 0.45rem; border-radius: 3px; border: 1px solid var(--line-strong); color: var(--text); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .tag.mine { margin-left: 0.5rem; border-color: var(--accent); background: var(--accent); color: var(--on-accent); vertical-align: middle; }
  .panel { display: grid; gap: 0.75rem; padding: var(--space-3); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
  .media { display: grid; gap: var(--space-2); min-width: 0; }
  .lk { font-weight: 600; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  th, td { text-align: left; vertical-align: top; padding: 0.55rem 0.75rem 0.55rem 0; border-bottom: 1px solid var(--line); }
  thead th { font-weight: 500; color: var(--text-2); border-bottom-color: var(--line-strong); }
  tbody th { font-weight: 600; }
  .num-v { font-variant-numeric: tabular-nums; white-space: nowrap; }
