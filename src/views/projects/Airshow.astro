---
// Airshow — bilingual photography project page. Sitan's own photographs and video.
// Layout: DESIGN.md (hero text | photo, video | text, then the photographs as a two-column grid).
// Photos: every src/assets/airshow/photo-*.jpg is shown automatically (add more with scripts/add-airshow-photos.py).
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Zoom from '../../components/Zoom.astro';
import Lightbox from '../../components/Lightbox.astro';
import { useT, type Lang } from '../../i18n/ui';
import { page, url } from '../../lib/url';
import { nextOf } from '../../data/projects';
import { copy, photoAlt, genericAlt } from '../../data/airshow';
import poster from '../../assets/airshow/video-poster.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const t = useT(lang);
const next = nextOf('airshow');

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/airshow/photo-*.jpg', { eager: true });
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const key = path.split('/').pop()!.replace('.jpg', '');
    return { key, src: mod.default, alt: (photoAlt[key] ?? genericAlt)[lang] };
  });
const [lead, ...rest] = photos;
---

<Base lang={lang} route="/work/airshow/" title="Airshow" description={c.tagline} image={lead.src}>
  <article class="project airshow">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <ol role="list">
        <li><a href={page(lang, '/work/')}>{t('nav.work')}</a></li>
        <li aria-current="page">Airshow</li>
      </ol>
    </nav>

    <!-- Hero: text | lead photograph -->
    <header class="wrap row hero">
      <div class="prose">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="tagline">{c.tagline}</p>
        <p>{c.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#video">{c.cta} <span aria-hidden="true">↓</span></a>
          <a class="btn" href="#photos">{c.ctaSecondary}</a>
        </div>
      </div>
      <Zoom src={lead.src} alt={lead.alt} caption={c.heroCaption} loading="eager" widths={[640, 1100, 1440]} sizes="(min-width: 48rem) 600px, 100vw" />
    </header>
    <dl class="wrap details">{c.details.map((d) => <div><dt>{d.k}</dt><dd>{d.v}</dd></div>)}</dl>

    <!-- 01 Video: player | text -->
    <section id="video" class="wrap block row wide-media flip" aria-labelledby="vd-h">
      <div class="prose">
        <p class="eyebrow num">{c.video.eyebrow}</p>
        <h2 id="vd-h">{c.video.title}</h2>
        <p>{c.video.body}</p>
        <p class="small muted">{c.video.note}</p>
      </div>
      <div class="media">
        <video class="film" controls playsinline preload="metadata" poster={poster.src} width={poster.width} height={poster.height} aria-label={c.video.title}>
          <source src={url('/video/airshow/airshow.mp4')} type="video/mp4" />
          <a href={url('/video/airshow/airshow.mp4')}>{c.video.title}</a>
        </video>
      </div>
    </section>

    <!-- 02 Photographs: heading, then a two-column grid (each opens larger) -->
    <section id="photos" class="wrap block" aria-labelledby="ph-h">
      <div class="wide-text">
        <p class="eyebrow num">{c.gallery.eyebrow}</p>
        <h2 id="ph-h">{c.gallery.title}</h2>
        <p class="muted">{photos.length} {c.gallery.count} · {c.gallery.body}</p>
      </div>
      <ul class="grid" role="list">
        {rest.map((p) => (
          <li><Zoom src={p.src} alt={p.alt} ratio="3 / 2" fit="cover" widths={[600, 900, 1440]} sizes="(min-width: 48rem) 560px, 100vw" /></li>
        ))}
      </ul>
    </section>

    <nav class="wrap bottom-nav" aria-label={lang === 'zh' ? '项目导航' : 'Project navigation'}>
      <a class="text-link" href={page(lang, '/work/')}>← {t('project.back')}</a>
      <a class="next" href={page(lang, `/work/${next.slug}/`)}>
        <span class="eyebrow">{t('project.next')}</span>
        <span class="next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
  <Lightbox />
</Base>

<style>
  .crumbs { padding-top: var(--space-3); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; font-size: var(--step--1); color: var(--text-2); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; margin-block: -0.6rem; color: var(--text-2); }
  .airshow .eyebrow.num { color: var(--accent); font-weight: 600; }

  .hero { padding-top: var(--space-2); }
  .hero h1 { font-size: var(--step-3); }
  .tagline { font-size: var(--step-2); font-family: var(--font-display); font-weight: 400; letter-spacing: -0.01em; line-height: 1.2; }
  .ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .details { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem var(--space-3); margin-top: var(--space-4); padding-block: var(--space-2); border-block: 1px solid var(--line); }
  .details dt { font-size: var(--step--1); color: var(--text-2); }
  .details dd { margin: 0; font-size: var(--step--1); font-weight: 500; }

  .film { display: block; width: 100%; height: auto; border-radius: var(--radius); background: var(--dark); }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: var(--space-3) 0 0; padding: 0; list-style: none; }
  .grid :global(.zoom) { margin: 0; }
  .grid :global(img) { width: 100%; border-radius: var(--radius); }

  .bottom-nav { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .next { display: grid; gap: 0.3rem; text-align: right; text-decoration: none; margin-left: auto; }
  .next .eyebrow { color: var(--text-2); }
  .next-title { font-size: var(--step-2); font-family: var(--font-display); font-weight: 400; letter-spacing: -0.01em; }

  @media (max-width: 47.99rem) {
    .details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid { grid-template-columns: 1fr; }
  }
</style>
