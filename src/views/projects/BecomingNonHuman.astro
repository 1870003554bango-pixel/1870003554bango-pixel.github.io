  .flow { display: grid; gap: 0.6rem; margin-top: var(--space-4); padding-top: var(--space-2); border-top: 1px solid var(--line); }
  .flow ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0; padding: 0; list-style: none; font-weight: 600; }
