---
// Becoming Non-Human — bilingual project page (team VR prototype, DECO3009).
// Brief: md文件/3009/Becoming_Non_Human_Portfolio_Brief_EN_ZH.md · Layout: DESIGN.md (paired rows; text-only = full width).
// Images are embedded originals extracted from the final report and labelled as such.
// Turtle World clips (03B–03D) are cut from Sitan's headset screen recording of the running prototype.
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Zoom from '../../components/Zoom.astro';
import Lightbox from '../../components/Lightbox.astro';
import { useT, type Lang } from '../../i18n/ui';
import { page, url } from '../../lib/url';
import waterPoster from '../../assets/becoming-non-human/clip-turtle-waterline.jpg';
import rubbishPoster from '../../assets/becoming-non-human/clip-turtle-rubbish.jpg';
import goalPoster from '../../assets/becoming-non-human/clip-turtle-destination.jpg';
import introPoster from '../../assets/becoming-non-human/clip-turtle-intro.jpg';
import CodeBlock from '../../components/CodeBlock.astro';
import { nextOf } from '../../data/projects';
import { copy, snippets } from '../../data/becoming-non-human';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const t = useT(lang);
const next = nextOf('becoming-non-human');

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/becoming-non-human/*.jpg', { eager: true });
const img = (key: string): ImageMetadata => {
  const f = files[`../../assets/becoming-non-human/${key}.jpg`];
  if (!f) throw new Error(`Missing Becoming Non-Human image: ${key}`);
  return f.default;
};
// World tiles: the turtle tile shows the turtle itself; the island view is used later for the destination.
const worldImg: Record<string, string> = { bat: 'report-bat', spider: 'report-spider', turtle: 'report-turtle' };
const worldAlt: Record<string, string> = { turtle: c.turtle.imgAlt };
const d = Object.fromEntries(c.turtle.details.map((x) => [x.id, x]));
const clips = {
  water: { src: url('/video/becoming-non-human/turtle-waterline.mp4'), poster: waterPoster, label: c.turtle.clipWaterLabel, caption: c.turtle.clipWater },
  rubbish: { src: url('/video/becoming-non-human/turtle-rubbish.mp4'), poster: rubbishPoster, label: c.turtle.clipRubbishLabel, caption: c.turtle.clipRubbish },
  goal: { src: url('/video/becoming-non-human/turtle-destination.mp4'), poster: goalPoster, label: c.turtle.clipGoalLabel, caption: c.turtle.clipGoal },
  intro: { src: url('/video/becoming-non-human/turtle-intro.mp4'), poster: introPoster, label: c.turtle.clipIntroLabel, caption: c.turtle.clipIntro },
};
const b = c.build;
const cn = b.codeNote;
---

<Base lang={lang} route="/work/becoming-non-human/" title="Becoming Non-Human" description={c.tagline} image={img('report-overview')}>
  <article class="project bnh">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <ol role="list">
        <li><a href={page(lang, '/work/')}>{t('nav.work')}</a></li>
        <li aria-current="page">Becoming Non-Human</li>
      </ol>
    </nav>

    <!-- Hero: text | report overview image -->
    <header class="wrap row hero">
      <div class="prose">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="tagline">{c.tagline}</p>
        <p>{c.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#worlds">{c.ctaPrimary} <span aria-hidden="true">↓</span></a>
          <a class="btn" href="#contribution">{c.ctaSecondary}</a>
        </div>
      </div>
      <Zoom src={img('report-overview')} alt={c.heroAlt} caption={c.reportCaption} loading="eager" widths={[640, 1100, 1920]} sizes="(min-width: 48rem) 600px, 100vw" />
    </header>
    <dl class="wrap details">{c.details.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
    <nav class="wrap toc" aria-label={c.toc.label}>
      <p class="eyebrow">{c.toc.label}</p>
      <ol role="list">{c.toc.items.map((x) => <li><a href={`#${x.id}`}>{x.k}</a></li>)}</ol>
    </nav>

    <!-- 01 Three worlds: intro + scene order full width, then three world columns -->
    <section id="worlds" class="wrap block" aria-labelledby="wd-h">
      <div class="wide-text">
        <p class="eyebrow num">{c.worlds.eyebrow}</p>
        <h2 id="wd-h">{c.worlds.title}</h2>
        <p>{c.worlds.body}</p>
      </div>
      <ol class="worlds" role="list">
        {c.worlds.list.map((w, i) => (
          <li>
            <Zoom src={img(worldImg[w.id])} alt={worldAlt[w.id] ?? w.alt} caption={c.reportCaption} ratio="16 / 9" fit="cover" widths={[400, 800]} sizes="(min-width: 48rem) 380px, 100vw" />
            <p class="world-meta"><span class="num">{String(i + 1).padStart(2, '0')}</span><span class:list={['tag', { mine: w.id === 'turtle' }]}>{w.id === 'turtle' ? c.worlds.mineTag : c.worlds.teamTag}</span></p>
            <h3>{w.name}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ol>
      <div class="flow">
        <p class="eyebrow">{c.worlds.flowLabel}</p>
        <ol role="list">{c.worlds.flow.map((s, i) => <li class:list={{ mine: i === 3 }}>{s}</li>)}</ol>
      </div>
    </section>

    <!-- 02 Contribution: text | responsibility table, then the reconstructed outline full width -->
    <section id="contribution" class="wrap block" aria-labelledby="co-h">
      <div class="row">
        <div class="prose">
          <p class="eyebrow num">{c.contribution.eyebrow}</p>
          <h2 id="co-h">{c.contribution.title}</h2>
          <p>{c.contribution.body}</p>
        </div>
        <div class="resp-box">
          <table class="resp">
            <thead><tr>{c.contribution.tableHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{c.contribution.rows.map((r) => <tr><th scope="row">{r.k}</th><td>{r.v}</td><td class="muted">{r.s}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
      <figure class="outline">
        <p class="eyebrow">{c.contribution.diagramTitle}</p>
        <div class="scroll">
          <table>
            <thead><tr>{c.contribution.outlineHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>
              {c.contribution.outline.map((o) => (
                <tr class:list={{ mine: o.mine }}>
                  <th scope="row">{o.k}{o.mine && <span class="tag mine">{c.worlds.mineTag}</span>}</th>
                  <td>{o.role}</td><td>{o.move}</td><td>{o.goal}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <figcaption class="caveat"><span class="tag">{lang === 'zh' ? '整理' : 'Rebuilt'}</span>{c.contribution.diagramNote}</figcaption>
      </figure>
    </section>

    <!-- 03 Turtle World: intro | turtle, loop, then one row per system -->
    <section id="turtle" class="wrap block" aria-labelledby="tu-h">
      <div class="row flip">
        <div class="prose">
          <p class="eyebrow num">{c.turtle.eyebrow}</p>
          <h2 id="tu-h">{c.turtle.title}</h2>
          <p>{c.turtle.body}</p>
        </div>
        <Zoom src={img('report-turtle-island')} alt={c.turtle.goalAlt} caption={c.reportCaption} widths={[743]} sizes="(min-width: 48rem) 560px, 100vw" />
      </div>

      <div class="loop">
        <p class="eyebrow">{c.turtle.loopLabel}</p>
        <ol role="list">{c.turtle.loop.map((s, i) => <li><span class="num">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}</ol>
      </div>

      <!-- 03A current: text | explanatory diagram -->
      <div class="row detail">
        <div class="prose">
          <p class="num">{d.current.n}</p>
          <h3>{d.current.k}</h3>
          <p>{d.current.v}</p>
        </div>
        <figure class="drift">
          <!-- Parallelogram sum from one origin O(110,200): input O→(110,80), current O→(330,190), actual drift O→(330,70). -->
          <svg viewBox="0 0 400 240" role="img" aria-label={`${c.turtle.diagram.input} + ${c.turtle.diagram.current} = ${c.turtle.diagram.result}`}>
            <defs>
              <marker id="ah" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" markerUnits="strokeWidth" orient="auto"><path d="M0 0L10 5L0 10z" class="head" /></marker>
              <marker id="ah2" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="5" markerHeight="5" markerUnits="strokeWidth" orient="auto"><path d="M0 0L10 5L0 10z" class="head2" /></marker>
            </defs>
            <path d="M110 80 L330 70 L330 190" class="guide" />
            <line x1="110" y1="200" x2="110" y2="80" class="in" marker-end="url(#ah)" />
            <path d="M110 200 C 160 180, 200 220, 250 200 S 310 185, 330 190" class="cur" marker-end="url(#ah)" />
            <line x1="110" y1="200" x2="330" y2="70" class="res" marker-end="url(#ah2)" />
            <circle cx="110" cy="200" r="6" class="dot" />
            <text x="98" y="145" text-anchor="end">{c.turtle.diagram.input}</text>
            <text x="230" y="232" text-anchor="middle">{c.turtle.diagram.current}</text>
            <text x="200" y="118" text-anchor="middle" class="strong">{c.turtle.diagram.result}</text>
          </svg>
          <figcaption class="caveat"><span class="tag">{c.turtle.diagram.tag}</span>{c.turtle.diagram.note}</figcaption>
        </figure>
      </div>

      <!-- 03B waterline: clip | text -->
      <div class="row flip detail">
        <div class="prose">
          <p class="num">{d.water.n}</p>
          <h3>{d.water.k}</h3>
          <p>{d.water.v}</p>
        </div>
        <figure class="clip">
          <video controls playsinline preload="none" poster={clips.water.poster.src} width="720" height="720" aria-label={clips.water.label}>
            <source src={clips.water.src} type="video/mp4" />
            <a href={clips.water.src}>{clips.water.label}</a>
          </video>
          <figcaption class="caveat"><span class="tag">{c.turtle.clipTag}</span>{clips.water.caption}</figcaption>
        </figure>
      </div>

      <!-- 03C rubbish: text | clip -->
      <div class="row detail">
        <div class="prose">
          <p class="num">{d.rubbish.n}</p>
          <h3>{d.rubbish.k}</h3>
          <p>{d.rubbish.v}</p>
        </div>
        <figure class="clip">
          <video controls playsinline preload="none" poster={clips.rubbish.poster.src} width="720" height="720" aria-label={clips.rubbish.label}>
            <source src={clips.rubbish.src} type="video/mp4" />
            <a href={clips.rubbish.src}>{clips.rubbish.label}</a>
          </video>
          <figcaption class="caveat"><span class="tag">{c.turtle.clipTag}</span>{clips.rubbish.caption}</figcaption>
        </figure>
      </div>

      <!-- 03D destination: clip | text -->
      <div class="row flip detail">
        <div class="prose">
          <p class="num">{d.goal.n}</p>
          <h3>{d.goal.k}</h3>
          <p>{d.goal.v}</p>
        </div>
        <figure class="clip">
          <video controls playsinline preload="none" poster={clips.goal.poster.src} width="720" height="720" aria-label={clips.goal.label}>
            <source src={clips.goal.src} type="video/mp4" />
            <a href={clips.goal.src}>{clips.goal.label}</a>
          </video>
          <figcaption class="caveat"><span class="tag">{c.turtle.clipTag}</span>{clips.goal.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 04 Planning: text | intent → system, then the player journey full width -->
    <section id="planning" class="wrap block" aria-labelledby="pl-h">
      <div class="row">
        <div class="prose">
          <p class="eyebrow num">{c.planning.eyebrow}</p>
          <h2 id="pl-h">{c.planning.title}</h2>
          <p>{c.planning.body}</p>
        </div>
        <div class="intents">
          <p class="eyebrow">{c.planning.intentsTitle}</p>
          <dl>{c.planning.intents.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
        </div>
      </div>
      <figure class="journey">
        <p class="eyebrow">{c.planning.journeyTitle}</p>
        <div class="scroll">
          <table>
            <thead><tr>{c.planning.journeyHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{c.planning.journey.map((r, i) => <tr><th scope="row"><span class="num">{String(i + 1).padStart(2, '0')}</span>{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
          </table>
        </div>
      </figure>
    </section>

    <!-- 05 How it works: intro + stack + system map full width, then one paired row per system (text | code) -->
    <section id="build" class="wrap block" aria-labelledby="bu-h">
      <div class="wide-text">
        <p class="eyebrow num">{b.eyebrow}</p>
        <h2 id="bu-h">{b.title}</h2>
        <p>{b.body}</p>
      </div>
      <dl class="stack">{b.stack.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
      <figure class="sysmap">
        <p class="eyebrow">{b.mapTitle}</p>
        <div class="scroll">
          <table>
            <thead><tr><th scope="col">{b.mapHead[0]}</th><th scope="col" aria-hidden="true"></th><th scope="col">{b.mapHead[1]}</th><th scope="col" aria-hidden="true"></th><th scope="col">{b.mapHead[2]}</th></tr></thead>
            <tbody>{b.map.map((r) => <tr><td>{r[0]}</td><td class="arr" aria-hidden="true">→</td><th scope="row"><code>{r[1]}</code></th><td class="arr" aria-hidden="true">→</td><td>{r[2]}</td></tr>)}</tbody>
          </table>
        </div>
        <figcaption class="small muted">{b.mapNote}</figcaption>
      </figure>

      <!-- 05A movement -->
      <div class="row sticky tech code-row">
        <div class="prose">
          <p class="num">{b.move.n}</p>
          <h3>{b.move.k}</h3>
          {b.move.v.map((p) => <p>{p}</p>)}
          <div class="scroll">
            <table class="cmp">
              <thead><tr>{b.move.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{b.move.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
            </table>
          </div>
        </div>
        <div class="media"><CodeBlock title={snippets.move.file} code={snippets.move.code} note={cn} /></div>
      </div>

      <!-- 05B current -->
      <div class="row flip sticky tech code-row">
        <div class="prose">
          <p class="num">{b.current.n}</p>
          <h3>{b.current.k}</h3>
          {b.current.v.map((p) => <p>{p}</p>)}
          <figure class="blend">
            <p class="eyebrow">{b.current.blendLabel}</p>
            <div class="bar" role="img" aria-label={b.current.blend.map((x) => `${x.k} ${x.w}%`).join(', ')}>
              {b.current.blend.map((x, i) => <span class={`seg s${i + 1}`} style={`flex-basis:${x.w}%`}><strong>{x.w}%</strong></span>)}
            </div>
            <ol class="bar-key" role="list">{b.current.blend.map((x, i) => <li><span class={`sw s${i + 1}`} aria-hidden="true"></span>{x.k} · {x.s}</li>)}</ol>
            <figcaption class="small muted">{b.current.blendNote}</figcaption>
          </figure>
          <dl class="params">{b.current.rows.map((r) => <div><dt>{r[0]}</dt><dd>{r[1]}</dd></div>)}</dl>
        </div>
        <div class="media"><CodeBlock title={snippets.current.file} code={snippets.current.code} note={cn} /></div>
      </div>

      <!-- 05C debris -->
      <div class="row sticky tech code-row">
        <div class="prose">
          <p class="num">{b.debris.n}</p>
          <h3>{b.debris.k}</h3>
          {b.debris.v.map((p) => <p>{p}</p>)}
          <p class="eyebrow">{b.debris.pipeLabel}</p>
          <ol class="pipe" role="list">{b.debris.pipe.map((x, i) => <li><span class="num">{i + 1}</span>{x}</li>)}</ol>
        </div>
        <div class="media"><CodeBlock title={snippets.debris.file} code={snippets.debris.code} note={cn} /></div>
      </div>

      <!-- 05D water -->
      <div class="row flip sticky tech code-row">
        <div class="prose">
          <p class="num">{b.water.n}</p>
          <h3>{b.water.k}</h3>
          {b.water.v.map((p) => <p>{p}</p>)}
          <div class="scroll">
            <table class="cmp">
              <thead><tr>{b.water.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{b.water.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="small muted">{b.water.note}</p>
        </div>
        <div class="media"><CodeBlock title={snippets.water.file} code={snippets.water.code} note={cn} /></div>
      </div>

      <!-- 05E intro hand-over: text + code | recorded clip -->
      <div class="row sticky tech">
        <div class="prose">
          <p class="num">{b.intro.n}</p>
          <h3>{b.intro.k}</h3>
          {b.intro.v.map((p) => <p>{p}</p>)}
          <div class="scroll">
            <table class="cmp">
              <thead><tr>{b.intro.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{b.intro.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
            </table>
          </div>
          <CodeBlock title={snippets.intro.file} code={snippets.intro.code} note={cn} />
        </div>
        <div class="media">
          <figure class="clip">
            <video controls playsinline preload="none" poster={clips.intro.poster.src} width="720" height="720" aria-label={clips.intro.label}>
              <source src={clips.intro.src} type="video/mp4" />
              <a href={clips.intro.src}>{clips.intro.label}</a>
            </video>
            <figcaption class="caveat"><span class="tag">{c.turtle.clipTag}</span>{clips.intro.caption}</figcaption>
          </figure>
        </div>
      </div>

      <!-- 05F health, distance, end -->
      <div class="row flip tech code-row">
        <div class="prose">
          <p class="num">{b.end.n}</p>
          <h3>{b.end.k}</h3>
          {b.end.v.map((p) => <p>{p}</p>)}
          <dl class="params">{b.end.rows.map((r) => <div><dt>{r[0]}</dt><dd>{r[1]}</dd></div>)}</dl>
        </div>
        <CodeBlock title={snippets.end.file} code={snippets.end.code} note={cn} />
      </div>
    </section>

    <!-- 06 On the headset: text + problem table → full width -->
    <section id="headset" class="wrap block" aria-labelledby="hs-h">
      <div class="wide-text">
        <p class="eyebrow num">{c.headset.eyebrow}</p>
        <h2 id="hs-h">{c.headset.title}</h2>
        <p>{c.headset.body}</p>
      </div>
      <div class="scroll">
        <table class="issues">
          <thead><tr>{c.headset.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {c.headset.rows.map((r) => (
              <tr class:list={[r.status]}>
                <th scope="row">{r.k}</th><td>{r.what}</td><td>{r.fix}</td>
                <td><span class:list={['status', r.status]}><span aria-hidden="true">{r.status === 'solved' ? '✓' : '○'}</span>{r.status === 'solved' ? c.headset.solved : c.headset.open}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 07 Testing: text, figures and findings → full width -->
    <section id="testing" class="wrap block wide-text" aria-labelledby="te-h">
      <p class="eyebrow num">{c.testing.eyebrow}</p>
      <h2 id="te-h">{c.testing.title}</h2>
      <p>{c.testing.body}</p>
      <div class="stats">
        {c.testing.highlights.map((h) => <div><p class="stat-v">{h.v}<span>/5</span></p><p class="stat-k">{h.k}</p></div>)}
      </div>
      <p class="small muted">{c.testing.outOf}</p>
      <div class="two">
        <div>
          <h3 class="sub-h">{c.testing.otherTitle}</h3>
          <dl class="scores">{c.testing.other.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
        </div>
        <div>
          <h3 class="sub-h">{c.testing.discomfortTitle}</h3>
          <dl class="scores">{c.testing.discomfort.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
        </div>
      </div>
      <h3 class="sub-h">{c.testing.perTitle}</h3>
      <div class="scroll">
        <table class="per">
          <thead><tr><th scope="col"><span class="sr-only">{c.testing.perTitle}</span></th>{c.testing.perHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {c.testing.per.map((r) => (
              <tr>
                <th scope="row"><span class="per-k">{r.k}</span><span class="per-q">{r.q}</span></th>
                {r.scores.map((v) => <td><span class="score" data-v={v}>{v}</span></td>)}
                <td class="mean">{r.mean}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="caveat"><span class="tag">n = 5</span>{c.testing.note}</p>
      <h3 class="sub-h">{c.testing.quotesTitle}</h3>
      <ul class="quotes" role="list">{c.testing.quotes.map((x) => <li><blockquote><p>{x.q}</p></blockquote></li>)}</ul>
      {c.testing.quotesNote && <p class="small muted">{c.testing.quotesNote}</p>}
      <h3 class="sub-h">{c.testing.findingsTitle}</h3>
      <div class="scroll">
        <table class="findings">
          <thead><tr>{c.testing.findingsHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{c.testing.findings.map((f) => <tr><td>{f.k}</td><td>{f.v}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <!-- 08 Reflection: text only → full width -->
    <section id="reflection" class="wrap block wide-text" aria-labelledby="re-h">
      <p class="eyebrow num">{c.reflection.eyebrow}</p>
      <h2 id="re-h">{c.reflection.title}</h2>
      <p>{c.reflection.body}</p>
      <p>{c.reflection.body2}</p>
      <h3 class="sub-h">{c.reflection.futureTitle}</h3>
      <p class="small muted">{c.reflection.futureNote}</p>
      <dl class="future">{c.reflection.future.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
    </section>

    <!-- 09 Credits -->
    <section class="wrap block wide-text credits" aria-labelledby="cr-h">
      <p class="eyebrow num">{c.credits.eyebrow}</p>
      <h2 id="cr-h">{c.credits.title}</h2>
      <p>{c.credits.body}</p>
      <p class="muted">{c.credits.imagesNote}</p>
      <details>
        <summary>{c.credits.assetsSummary}</summary>
        <ul>{c.credits.assets.map((a) => <li>{a}</li>)}</ul>
      </details>
    </section>

    <nav class="wrap bottom-nav" aria-label={lang === 'zh' ? '项目导航' : 'Project navigation'}>
      <a class="text-link" href={page(lang, '/work/')}>← {t('project.back')}</a>
      <a class="next" href={page(lang, `/work/${next.slug}/`)}>
        <span class="eyebrow">{t('project.next')}</span>
        <span class="next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
  <Lightbox />
</Base>

<style>
  .crumbs { padding-top: var(--space-3); }
