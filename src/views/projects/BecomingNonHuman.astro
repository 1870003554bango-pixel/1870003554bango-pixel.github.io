  .tagline { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .details { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.6rem var(--space-3); margin-top: var(--space-4); padding-block: var(--space-2); border-block: 1px solid var(--line); }
