---
// Bespoke project page — brief: md文件/through the window/Through_the_Window_Claude_Brief_EN.md
// Public copy is English on both language routes; the Chinese route keeps Chinese navigation.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import { useT, type Lang } from '../../i18n/ui';
import { page, url } from '../../lib/url';
import { nextOf, projects } from '../../data/projects';
import { copy as c, liveUrl, skyColors } from '../../data/through-the-window';

import photo from '../../assets/through-the-window/airplane-window-inspiration.jpg';
import dawn from '../../assets/through-the-window/dawn.jpg';
import daylight from '../../assets/through-the-window/daylight.jpg';
import sunset from '../../assets/through-the-window/sunset.jpg';
import night from '../../assets/through-the-window/night.jpg';
import detailClock from '../../assets/through-the-window/detail-analogue-clock.jpg';
import detailDigital from '../../assets/through-the-window/detail-digital-clock.jpg';
import detailBooks from '../../assets/through-the-window/detail-books.jpg';
import wDay from '../../assets/through-the-window/window-day-clouds.jpg';
import wOcean from '../../assets/through-the-window/window-ocean-atoll.jpg';
import wLast from '../../assets/through-the-window/window-last-light.jpg';
import wStorm from '../../assets/through-the-window/window-sunset-storm.jpg';
import wTwilight from '../../assets/through-the-window/window-twilight-lights.jpg';
import wNight from '../../assets/through-the-window/window-night-stars.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const project = projects.find((p) => p.slug === 'through-the-window')!;
const next = nextOf(project.slug);
const frames = { dawn, daylight, sunset, night } as const;
const details = { 'detail-analogue-clock': detailClock, 'detail-digital-clock': detailDigital, 'detail-books': detailBooks } as const;
const demo = url('/demos/through-the-window/index.html');
const windowPhotos = {
  'window-day-clouds': wDay, 'window-ocean-atoll': wOcean, 'window-last-light': wLast,
  'window-sunset-storm': wStorm, 'window-twilight-lights': wTwilight, 'window-night-stars': wNight,
} as const;
const gallery = c.inspiration.gallery.map((g) => ({ src: windowPhotos[g.key as keyof typeof windowPhotos], alt: g.alt, caption: g.caption }));
---

<Base lang={lang} route="/work/through-the-window/" title={c.title} description={c.tagline} image={sunset}>
  <article lang="en" class="project ttw">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <ol role="list">
        <li><a href={page(lang, '/work/')}>{t('nav.work')}</a></li>
        <li aria-current="page">{c.title}</li>
      </ol>
      {lang === 'zh' && <p class="en-only" lang="zh-CN">{t('project.enOnly')}</p>}
    </nav>

    <!-- A · Hero -->
    <header class="wrap hero">
      <div class="hero-text">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="tagline">{c.tagline}</p>
        <p class="intro">{c.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#experience">{c.ctaPrimary} <span aria-hidden="true">↓</span></a>
          <a class="btn" href={liveUrl} target="_blank" rel="noopener noreferrer">{c.ctaSecondary} <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <dl class="meta">
          {c.meta.map((m) => <div><dt>{m.k}</dt><dd>{m.v}</dd></div>)}
        </dl>
      </div>
      <figure class="hero-photo">
        <Image src={photo} alt={c.photoAlt} widths={[480, 768, 1152, 1536]}
          sizes="(min-width: 75rem) 440px, (min-width: 44rem) 38vw, 100vw" loading="eager" fetchpriority="high" />
        <figcaption>{c.photoCaption}</figcaption>
      </figure>
    </header>

    <!-- B · Experience: wide live sketch, heading and text side by side above it -->
    <section id="experience" class="wrap block" aria-labelledby="experience-heading">
      <div class="head-row">
        <h2 id="experience-heading">{c.experience.title}</h2>
        <p>{c.experience.body}</p>
      </div>
      <div class="sketch-embed">
        <iframe src={demo} title={c.experience.iframeTitle} loading="lazy" allowfullscreen allow="fullscreen"></iframe>
      </div>
      <ol class="steps" role="list">
        {c.experience.steps.map((s, i) => (
          <li><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <div class="open-row">
        <a class="btn btn-primary" href={liveUrl} target="_blank" rel="noopener noreferrer">{c.experience.open} <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="text-link" href={demo} target="_blank" rel="noopener">{c.experience.mirror}</a>
        <p class="note">{c.experience.note} <span class="mobile-note">{c.experience.mobile}</span></p>
      </div>
    </section>

    <!-- C · Inspiration: text | photo carousel -->
    <section class="wrap block row" aria-labelledby="inspiration-heading">
      <div class="prose">
        <h2 id="inspiration-heading">{c.inspiration.title}</h2>
        {c.inspiration.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="gallery">
        <PhotoCarousel slides={gallery} label={c.inspiration.galleryLabel} ratio="3 / 4"
          sizes="(min-width: 32rem) 440px, 100vw" />
        <p class="muted small">{c.inspiration.galleryNote}</p>
      </div>
    </section>

    <!-- D · Twenty-four hours: four frames | text + palette -->
    <section class="wrap block row flip" aria-labelledby="day-heading">
      <div class="prose">
        <h2 id="day-heading">{c.day.title}</h2>
        {c.day.body.map((p) => <p>{p}</p>)}
        <figure class="palette">
          <figcaption>
            <span class="eyebrow">{c.inspiration.paletteTitle}</span>
            <span class="muted small">{c.inspiration.paletteNote}</span>
          </figcaption>
          <ol role="list">
            {skyColors.map((s) => (
              <li>
                <span class="swatch" style={`background: linear-gradient(${s.top}, ${s.bot})`} aria-hidden="true"></span>
                <span class="hour">{String(s.h).padStart(2, '0')}</span>
              </li>
            ))}
          </ol>
        </figure>
      </div>
      <div>
        <ul class="frames" role="list">
          {c.day.frames.map((f) => (
            <li>
              <figure>
                <Image src={frames[f.key as keyof typeof frames]} alt={f.alt} widths={[400, 800, 1200]}
                  sizes="(min-width: 48rem) 270px, 50vw" />
                <figcaption><span class="eyebrow">{f.label}</span><span class="muted">{f.time}</span></figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="muted small frames-note">{c.day.caption}</p>
      </div>
    </section>

    <!-- E · Interactions: heading row, then zig-zag detail | text -->
    <section class="wrap block" aria-labelledby="interactions-heading">
      <div class="head-row">
        <h2 id="interactions-heading">{c.interactions.title}</h2>
        <p>{c.interactions.body}</p>
      </div>
      <ol class="features" role="list">
        {c.interactions.rows.map((r, i) => (
          <li class:list={['row', 'feature', { flip: i % 2 === 0 }]}>
            <div class="feature-text">
              <p class="num">{r.n}</p>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
            <Image src={details[r.img as keyof typeof details]} alt={r.alt} widths={[360, 720]} sizes="(min-width: 48rem) 420px, 100vw" />
          </li>
        ))}
      </ol>
    </section>

    <!-- F · Behind the scene: text | code, then annotated scene | legend -->
    <section class="wrap block" aria-labelledby="rules-heading">
      <div class="row">
        <div class="prose">
          <h2 id="rules-heading">{c.rules.title}</h2>
          {c.rules.body.map((p) => <p>{p}</p>)}
        </div>
        <figure class="code">
          <pre><code>{c.rules.code}</code></pre>
          <figcaption class="muted small">{c.rules.codeCaption}</figcaption>
        </figure>
      </div>
      <div class="row flip annotated-row">
        <div class="legend-col">
          <ol class="legend" role="list">
            {c.rules.annotations.map((a) => <li><span class="marker static" aria-hidden="true">{a.n}</span>{a.label}</li>)}
          </ol>
          <details class="how">
            <summary>{c.rules.howTitle}</summary>
            <ul>{c.rules.how.map((h) => <li>{h}</li>)}</ul>
          </details>
        </div>
        <figure class="annotated">
          <div class="annotated-frame">
            <Image src={daylight} alt={c.rules.annotatedAlt} widths={[600, 900, 1200]} sizes="(min-width: 48rem) 540px, 100vw" />
            {c.rules.annotations.map((a) => (
              <span class="marker" style={`left: ${a.x}%; top: ${a.y}%`} aria-hidden="true">{a.n}</span>
            ))}
          </div>
        </figure>
      </div>
    </section>

    <!-- G · Reflection: text | quote + credits -->
    <section class="wrap block row reflection" aria-labelledby="reflection-heading">
      <div class="prose">
        <h2 id="reflection-heading">{c.reflection.title}</h2>
        {c.reflection.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="quote-col">
        <blockquote><p>“{c.reflection.quote}”</p></blockquote>
        <ul class="credits" role="list">
          {c.credits.map((cr) => <li>{cr}</li>)}
        </ul>
      </div>
    </section>

    <nav class="wrap bottom-nav" aria-label="Project navigation">
      <a class="text-link" href={page(lang, '/work/')}>← All Work</a>
      <a class="next" href={page(lang, `/work/${next.slug}/`)}>
        <span class="eyebrow">Next Project</span>
        <span class="next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>

  .crumbs { padding-top: var(--space-3); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; font-size: var(--step--1); color: var(--text-2); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; margin-block: -0.6rem; color: var(--text-2); }
  .crumbs a:hover { color: var(--text); }
  .en-only { margin-top: 0.5rem; font-size: var(--step--1); color: var(--text-2); }

  /* A */
  .hero { display: grid; gap: var(--space-4); align-items: center; padding-block: var(--space-4) var(--space-5); }
  @media (min-width: 44rem) { .hero { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-4); } }
  @media (min-width: 64rem) { .hero { gap: var(--space-5); } }
  .hero-photo { margin: 0; display: grid; gap: 0.6rem; }
  .hero-photo img { width: 100%; height: auto; border-radius: var(--radius); }
  @media (max-width: 43.99rem) { .hero-photo { max-width: 26rem; } }
  .hero-photo figcaption, figcaption { font-size: var(--step--1); color: var(--text-2); }
  .hero-text { display: grid; gap: var(--space-2); justify-items: start; }
  h1 { font-size: var(--step-3); }
  .tagline { font-size: var(--step-1); font-weight: 500; }
  .intro { max-width: 62ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; padding-top: var(--space-1); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); margin: var(--space-2) 0 0; padding-top: var(--space-2); border-top: 1px solid var(--line); width: 100%; }
  .meta dt { font-size: var(--step--1); color: var(--text-2); }
  .meta dd { margin: 0; font-size: var(--step--1); font-weight: 500; }


  /* B */
  .sketch-embed {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 10px;
    background: var(--text);
  }
  @media (min-width: 75rem) and (min-height: 50rem) { .sketch-embed { width: min(100%, calc((100vh - var(--header-h) - 3rem) * 4 / 3)); margin-inline: auto; } }
  .sketch-embed iframe { display: block; width: 100%; height: 100%; border: 0; }
  .steps { display: grid; gap: var(--space-2) var(--space-3); margin: var(--space-3) 0 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .steps li { display: grid; gap: 0.2rem; padding-top: var(--space-2); border-top: 1px solid var(--line-strong); }
  .steps h3 { font-size: var(--step-0); font-weight: 600; }
  .steps p { color: var(--text-2); }
  .open-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-3); margin-top: var(--space-3); }
  .open-row .text-link { font-size: var(--step--1); }
  .note { flex-basis: 100%; font-size: var(--step--1); color: var(--text-2); }
  .mobile-note { display: none; }
  @media (max-width: 47.99rem) { .mobile-note { display: inline; } }

  /* C */
  .gallery { display: grid; gap: 0.5rem; width: 100%; max-width: 28rem; justify-self: center; }

  /* D */
  .palette { margin: var(--space-1) 0 0; display: grid; gap: 0.75rem; }
  .palette figcaption { display: grid; gap: 0.2rem; }
  .palette .eyebrow { margin: 0; }
  .palette ol { display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); gap: 3px; margin: 0; padding: 0; list-style: none; }
  .palette li { display: grid; gap: 0.3rem; }
  .swatch { display: block; aspect-ratio: 1 / 1.6; border-radius: 3px; }
  .hour { font-size: 0.6875rem; color: var(--text-2); font-variant-numeric: tabular-nums; text-align: center; }
  .frames { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2) 0.75rem; margin: 0; padding: 0; list-style: none; }
  .frames figure { margin: 0; display: grid; gap: 0.4rem; }
  .frames img { width: 100%; height: auto; border-radius: var(--radius); }
  .frames figcaption { display: flex; justify-content: space-between; align-items: baseline; font-size: var(--step--1); }
  .frames figcaption .eyebrow { margin: 0; color: var(--text); }
  .frames-note { margin-top: 0.75rem !important; }

  /* E */
  .features { margin: 0; padding: 0; list-style: none; }
  .feature { padding-top: var(--space-3); margin-top: var(--space-3); border-top: 1px solid var(--line); }
  .feature img { width: 100%; height: auto; border-radius: var(--radius); }
  .feature-text { display: grid; gap: 0.4rem; max-width: 46ch; }
  .feature h3 { font-size: var(--step-1); font-weight: 600; }
  @media (min-width: 48rem) {
    .feature { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-4); }
    .feature.flip { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
    .feature + .feature { margin-top: var(--space-3); }
  }

  /* F */
  .code { margin: 0; display: grid; gap: 0.5rem; min-width: 0; }
  .code pre {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  .annotated { margin: 0; }
  .annotated-frame { position: relative; }
  .annotated-frame img { width: 100%; height: auto; border-radius: var(--radius); }
  .marker {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: 0 0 0 2px var(--bg);
  }
  .annotated-frame .marker { position: absolute; transform: translate(-50%, -50%); }
  .legend-col { display: grid; gap: var(--space-2); align-content: center; }
  .legend { display: grid; gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
  .legend li { display: flex; align-items: center; gap: 0.75rem; }
  .marker.static { box-shadow: none; }
  .how { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .how summary { display: flex; align-items: center; min-height: 48px; cursor: pointer; font-weight: 600; }
  .how ul { margin: 0 0 var(--space-2); padding-left: 1.25rem; display: grid; gap: 0.4rem; color: var(--text-2); font-size: var(--step--1); }

  /* G */
  .reflection { align-items: start; }
  .quote-col { display: grid; gap: var(--space-3); }
  blockquote { margin: 0; padding-block: var(--space-3); border-block: 1px solid var(--line); }
  blockquote p { font-size: clamp(1.6rem, 2.4vw + 1rem, 2.6rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
  .credits { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.25rem; font-size: var(--step--1); color: var(--text-2); }

  .bottom-nav { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .next { display: grid; gap: 0.3rem; text-align: right; text-decoration: none; margin-left: auto; }
  .next .eyebrow { margin: 0; }
  .next-title { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; }
</style>
