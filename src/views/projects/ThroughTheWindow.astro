---
// Bespoke project page — brief: md文件/through the window/Through_the_Window_Claude_Brief_EN.md
// Public copy is English on both language routes; the Chinese route keeps Chinese navigation.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import { useT, type Lang } from '../../i18n/ui';
import { page, url } from '../../lib/url';
import { nextOf, projects } from '../../data/projects';
import { copy, labels, liveUrl, skyColors, skyColorsEnd, techSnippets as code, grassColors } from '../../data/through-the-window';
import CodeBlock from '../../components/CodeBlock.astro';
import trail100 from '../../assets/through-the-window/trail-100x.jpg';
import trail10k from '../../assets/through-the-window/trail-10000x.jpg';
import trail100k from '../../assets/through-the-window/trail-100000x.jpg';

import photo from '../../assets/through-the-window/airplane-window-inspiration.jpg';
import dawn from '../../assets/through-the-window/dawn.jpg';
import daylight from '../../assets/through-the-window/daylight.jpg';
import sunset from '../../assets/through-the-window/sunset.jpg';
import night from '../../assets/through-the-window/night.jpg';
import detailClock from '../../assets/through-the-window/detail-analogue-clock.jpg';
import detailDigital from '../../assets/through-the-window/detail-digital-clock.jpg';
import detailBooks from '../../assets/through-the-window/detail-books.jpg';
import wDay from '../../assets/through-the-window/window-day-clouds.jpg';
import wOcean from '../../assets/through-the-window/window-ocean-atoll.jpg';
import wLast from '../../assets/through-the-window/window-last-light.jpg';
import wStorm from '../../assets/through-the-window/window-sunset-storm.jpg';
import wTwilight from '../../assets/through-the-window/window-twilight-lights.jpg';
import wNight from '../../assets/through-the-window/window-night-stars.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const c = copy[lang];
const L = labels[lang];
const project = projects.find((p) => p.slug === 'through-the-window')!;
const next = nextOf(project.slug);
const frames = { dawn, daylight, sunset, night } as const;
const details = { 'detail-analogue-clock': detailClock, 'detail-digital-clock': detailDigital, 'detail-books': detailBooks } as const;
const demo = url('/demos/through-the-window/index.html');
const windowPhotos = {
  'window-day-clouds': wDay, 'window-ocean-atoll': wOcean, 'window-last-light': wLast,
  'window-sunset-storm': wStorm, 'window-twilight-lights': wTwilight, 'window-night-stars': wNight,
} as const;
const gallery = c.inspiration.gallery.map((g) => ({ src: windowPhotos[g.key as keyof typeof windowPhotos], alt: g.alt, caption: g.caption }));

// Technical deep dive
const x = c.tech;
const trailImgs = { 'trail-100x': trail100, 'trail-10000x': trail10k, 'trail-100000x': trail100k } as const;
const trailSlides = x.trails.slides.map((s) => ({ src: trailImgs[s.key as keyof typeof trailImgs], alt: s.alt, caption: s.caption }));
const meteorFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/through-the-window/meteor-*.jpg', { eager: true });
const meteorImg = (k: string) => meteorFiles[`../../assets/through-the-window/${k}.jpg`].default;
const keyframes = [...skyColors, skyColorsEnd];
// Sun and moon share one straight path (window top-left → right end of horizon), drawn at five evenly spaced times.
const pathPts = [0, 0.25, 0.5, 0.75, 1].map((f, i) => ({ x: 40 + 320 * f, y: 30 + 150 * f, sun: ['06', '09', '12', '15', '18'][i], moon: ['18', '21', '00', '03', '06'][i] }));
// 24-hour bar: hour → x in a 0–480 strip
const hx = (h: number) => 96 + (h / 24) * 384;
---

<Base lang={lang} route="/work/through-the-window/" title={c.title} description={c.tagline} image={sunset}>
  <article class="project ttw">
    <nav class="wrap crumbs" aria-label={L.breadcrumb}>
      <ol role="list">
        <li><a href={page(lang, '/work/')}>{t('nav.work')}</a></li>
        <li aria-current="page">{c.title}</li>
      </ol>
    </nav>

    <!-- A · Hero -->
    <header class="wrap hero">
      <div class="hero-text">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="tagline">{c.tagline}</p>
        <p class="intro">{c.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#experience">{c.ctaPrimary} <span aria-hidden="true">↓</span></a>
          <a class="btn" href={liveUrl} target="_blank" rel="noopener noreferrer">{c.ctaSecondary} <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <dl class="meta">
          {c.meta.map((m) => <div><dt>{m.k}</dt><dd>{m.v}</dd></div>)}
        </dl>
      </div>
      <figure class="hero-photo">
        <Image src={photo} alt={c.photoAlt} widths={[480, 768, 1152, 1536]}
          sizes="(min-width: 75rem) 440px, (min-width: 44rem) 38vw, 100vw" loading="eager" fetchpriority="high" />
        <figcaption>{c.photoCaption}</figcaption>
      </figure>
    </header>

    <!-- B · Experience: wide live sketch, heading and text side by side above it -->
    <section id="experience" class="wrap block" aria-labelledby="experience-heading">
      <div class="wide-text intro-wide">
        <h2 id="experience-heading">{c.experience.title}</h2>
        <p>{c.experience.body}</p>
      </div>
      <div class="sketch-embed">
        <iframe src={demo} title={c.experience.iframeTitle} loading="lazy" allowfullscreen allow="fullscreen"></iframe>
      </div>
      <ol class="steps" role="list">
        {c.experience.steps.map((s, i) => (
          <li><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <div class="open-row">
        <a class="btn btn-primary" href={liveUrl} target="_blank" rel="noopener noreferrer">{c.experience.open} <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="text-link" href={demo} target="_blank" rel="noopener">{c.experience.mirror}</a>
        <p class="note">{c.experience.note} <span class="mobile-note">{c.experience.mobile}</span></p>
      </div>
    </section>

    <!-- C · Inspiration: text | photo carousel -->
    <section class="wrap block row sticky" aria-labelledby="inspiration-heading">
      <div class="prose pin">
        <h2 id="inspiration-heading">{c.inspiration.title}</h2>
        {c.inspiration.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="gallery">
        <PhotoCarousel slides={gallery} label={c.inspiration.galleryLabel} ratio="3 / 4"
          sizes="(min-width: 32rem) 440px, 100vw" />
        <p class="muted small">{c.inspiration.galleryNote}</p>
      </div>
    </section>

    <!-- D · Twenty-four hours: four frames | text + palette -->
    <section class="wrap block row flip wide-media" aria-labelledby="day-heading">
      <div class="prose">
        <h2 id="day-heading">{c.day.title}</h2>
        {c.day.body.map((p) => <p>{p}</p>)}
        <figure class="palette">
          <figcaption>
            <span class="eyebrow">{c.inspiration.paletteTitle}</span>
            <span class="muted small">{c.inspiration.paletteNote}</span>
          </figcaption>
          <ol role="list">
            {skyColors.map((s) => (
              <li>
                <span class="swatch" style={`background: linear-gradient(${s.top}, ${s.bot})`} aria-hidden="true"></span>
                <span class="hour">{String(s.h).padStart(2, '0')}</span>
              </li>
            ))}
          </ol>
        </figure>
      </div>
      <div>
        <ul class="frames" role="list">
          {c.day.frames.map((f) => (
            <li>
              <figure>
                <Image src={frames[f.key as keyof typeof frames]} alt={f.alt} widths={[400, 800, 1200]}
                  sizes="(min-width: 48rem) 330px, 50vw" />
                <figcaption><span class="eyebrow">{f.label}</span><span class="muted">{f.time}</span></figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="muted small frames-note">{c.day.caption}</p>
      </div>
    </section>

    <!-- E · Interactions: heading row, then zig-zag detail | text -->
    <section class="wrap block" aria-labelledby="interactions-heading">
      <div class="wide-text intro-wide">
        <h2 id="interactions-heading">{c.interactions.title}</h2>
        <p>{c.interactions.body}</p>
      </div>
      <ol class="features" role="list">
        {c.interactions.rows.map((r, i) => (
          <li class:list={['row', 'feature', { flip: i % 2 === 0 }]}>
            <div class="feature-text">
              <p class="num">{r.n}</p>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
            <Image src={details[r.img as keyof typeof details]} alt={r.alt} widths={[360, 720]} sizes="(min-width: 48rem) 420px, 100vw" />
          </li>
        ))}
      </ol>
    </section>

    <!-- F · Behind the scene: text | code, then annotated scene | legend -->
    <section class="wrap block" aria-labelledby="rules-heading">
      <div class="row">
        <div class="prose">
          <h2 id="rules-heading">{c.rules.title}</h2>
          {c.rules.body.map((p) => <p>{p}</p>)}
        </div>
        <figure class="code">
          <pre><code>{c.rules.code}</code></pre>
          <figcaption class="muted small">{c.rules.codeCaption}</figcaption>
        </figure>
      </div>
      <div class="row flip annotated-row">
        <div class="legend-col">
          <ol class="legend" role="list">
            {c.rules.annotations.map((a) => <li><span class="marker static" aria-hidden="true">{a.n}</span>{a.label}</li>)}
          </ol>
          <details class="how">
            <summary>{c.rules.howTitle}</summary>
            <ul>{c.rules.how.map((h) => <li>{h}</li>)}</ul>
          </details>
        </div>
        <figure class="annotated">
          <div class="annotated-frame">
            <Image src={daylight} alt={c.rules.annotatedAlt} widths={[600, 900, 1200]} sizes="(min-width: 48rem) 540px, 100vw" />
            {c.rules.annotations.map((a) => (
              <span class="marker" style={`left: ${a.x}%; top: ${a.y}%`} aria-hidden="true">{a.n}</span>
            ))}
          </div>
        </figure>
      </div>
    </section>

    <!-- F2 · Technical deep dive: A Sky Built Through Time (brief: md文件/through the window/DECO1012_Through_the_Window_Technical_Portfolio_Brief.md) -->
    <section id="tech" class="wrap block tech" aria-labelledby="tech-heading">
      <div class="wide-text">
        <p class="eyebrow accent">{x.eyebrow}</p>
        <h2 id="tech-heading">{x.title}</h2>
        <p class="sub">{x.sub}</p>
        {x.body.map((p) => <p>{p}</p>)}
      </div>
      <nav class="tech-toc" aria-label={`${x.title}: ${L.sections}`}>
        <ol role="list">{x.toc.map((t, i) => <li><a href={`#${t.id}`}><span class="num">{String(i + 1).padStart(2, '0')}</span>{t.k}</a></li>)}</ol>
      </nav>
      <figure class="tech-hero">
        <Image src={trail10k} alt={x.heroAlt} widths={[800, 1200, 1680]} sizes="(min-width: 75rem) 1200px, 100vw" />
        <figcaption>{x.heroCaption}</figcaption>
      </figure>

      <!-- 01 Time -->
      <div id="tech-time" class="row sticky t-row">
        <div class="prose">
          <p class="num">{x.time.n}</p>
          <h3>{x.time.title}</h3>
          {x.time.body.map((p) => <p>{p}</p>)}
          <p class="formula"><code>{x.time.formula}</code></p>
          <p class="small muted">{x.time.formulaKey}</p>
          <table class="t-table">
            <thead><tr>{x.time.speedHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.time.speeds.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td></tr>)}</tbody>
          </table>
        </div>
        <div class="media"><CodeBlock title={code.time.file} code={code.time.code} note={x.codeNote} lang="javascript" /></div>
      </div>

      <figure class="keyframes">
        <figcaption><span class="eyebrow">{x.palette.title}</span><span class="small muted">{x.palette.note}</span></figcaption>
        <div class="scroll">
          <ol role="list">
            {keyframes.map((k, i) => (
              <li>
                <span class="kf-swatch" style={`background: linear-gradient(${k.top}, ${k.bot})`} aria-hidden="true"></span>
                <span class="kf-h">{String(k.h).padStart(2, '0')}:00</span>
                <span class="kf-s">{x.palette.stages[i]}</span>
              </li>
            ))}
          </ol>
        </div>
      </figure>

      <div class="row flip sticky t-row">
        <div class="prose">
          <h3>{x.blend.title}</h3>
          {x.blend.body.map((p) => <p>{p}</p>)}
          <ol class="pipe" role="list">{x.blend.pipe.map((p) => <li>{p}</li>)}</ol>
        </div>
        <div class="media"><CodeBlock title={code.sky.file} code={code.sky.code} note={x.codeNote} lang="javascript" /></div>
      </div>

      <div class="row t-row">
        <div class="prose">
          <h3>{x.path.title}</h3>
          <p>{x.path.body}</p>
          <CodeBlock title={code.path.file} code={code.path.code} lang="javascript" />
        </div>
        <figure class="diagram">
          <svg viewBox="0 0 400 230" role="img" aria-label={`${x.path.sun} 06–18, ${x.path.moon} 18–06, along one path from the top-left of the window to the right end of the horizon.`}>
            <rect x="20" y="10" width="360" height="200" class="win" />
            <line x1="20" y1="180" x2="380" y2="180" class="horizon" />
            <text x="26" y="196" class="lbl">{x.path.horizon}</text>
            <line x1="40" y1="30" x2="360" y2="180" class="track" />
            {pathPts.map((p) => (
              <g>
                <circle cx={p.x} cy={p.y} r="6" class="sun" />
                <text x={p.x + 4} y={p.y - 11} class="t-sun">{p.sun}</text>
                <text x={p.x + 10} y={p.y + 16} class="t-moon">{p.moon}</text>
              </g>
            ))}
            <g transform="translate(36 214)"><circle r="5" class="sun" /><text x="10" y="4" class="lbl">{x.path.sun} 06–18</text><circle cx="110" r="5" class="moon" /><text x="120" y="4" class="lbl">{x.path.moon} 18–06</text></g>
          </svg>
          <figcaption class="small muted">{x.path.caption}</figcaption>
        </figure>
      </div>

      <div class="threshold">
        <h3>{x.threshold.title}</h3>
        <p>{x.threshold.body}</p>
        <svg viewBox="0 0 500 96" role="img" aria-label={x.threshold.aria}>
          <defs>
            <linearGradient id="dawnRamp"><stop offset="0" stop-color={grassColors.night} /><stop offset="1" stop-color={grassColors.day} /></linearGradient>
            <linearGradient id="duskRamp"><stop offset="0" stop-color={grassColors.day} /><stop offset="1" stop-color={grassColors.night} /></linearGradient>
          </defs>
          <text x="0" y="24" class="lbl">{x.threshold.rowStars}</text>
          <rect x={hx(0)} y="12" width={hx(6.3) - hx(0)} height="16" class="on" />
          <rect x={hx(18.2)} y="12" width={hx(24) - hx(18.2)} height="16" class="on" />
          <text x="0" y="58" class="lbl">{x.threshold.rowLand}</text>
          <rect x={hx(0)} y="46" width={hx(5.5) - hx(0)} height="16" fill={grassColors.night} />
          <rect x={hx(5.5)} y="46" width={hx(6.3) - hx(5.5)} height="16" fill="url(#dawnRamp)" />
          <rect x={hx(6.3)} y="46" width={hx(17.3) - hx(6.3)} height="16" fill={grassColors.day} />
          <rect x={hx(17.3)} y="46" width={hx(18.2) - hx(17.3)} height="16" fill="url(#duskRamp)" />
          <rect x={hx(18.2)} y="46" width={hx(24) - hx(18.2)} height="16" fill={grassColors.night} />
          {[0, 6, 12, 18, 24].map((h) => <text x={hx(h)} y="84" text-anchor="middle" class="tick">{String(h).padStart(2, '0')}:00</text>)}
        </svg>
        <p class="small muted">{x.threshold.caption}</p>
      </div>

      <!-- 02 Stars -->
      <div id="tech-stars" class="row sticky t-row">
        <div class="prose">
          <p class="num">{x.stars.n}</p>
          <h3>{x.stars.title}</h3>
          {x.stars.body.map((p) => <p>{p}</p>)}
          <table class="t-table">
            <thead><tr>{x.stars.paramHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.stars.params.map((r) => <tr><th scope="row"><code>{r[0]}</code></th><td>{r[1]}</td><td class="muted">{r[2]}</td></tr>)}</tbody>
          </table>
        </div>
        <div class="media"><CodeBlock title={L.fileStars} code={code.stars.code} note={x.codeNote} lang="javascript" /></div>
      </div>

      <div class="row flip sticky t-row">
        <div class="prose">
          <h3>{x.trails.title}</h3>
          {x.trails.body.map((p) => <p>{p}</p>)}
          <ol class="pipe" role="list">{x.trails.pipe.map((p) => <li>{p}</li>)}</ol>
        </div>
        <div class="media"><CodeBlock title={L.fileTrails} code={code.trails.code} note={x.codeNote} lang="javascript" /></div>
      </div>

      <div class="row wide-media t-row">
        <div class="prose">
          <h3>{x.trails.alphaTitle}</h3>
          <p>{x.trails.alphaBody}</p>
          <table class="t-table">
            <thead><tr>{x.trails.alphaHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.trails.alpha.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td class="muted">{r[2]}</td></tr>)}</tbody>
          </table>
        </div>
        <div class="trail-shots">
          <PhotoCarousel slides={trailSlides} label={x.trails.slidesLabel} ratio="7 / 3" sizes="(min-width: 48rem) 680px, 100vw" zoom prevLabel={L.prevSpeed} nextLabel={L.nextSpeed} />
          <p class="small muted">{x.trails.slidesNote}</p>
        </div>
      </div>

      <!-- 03 Meteors -->
      <div id="tech-meteors" class="row sticky t-row">
        <div class="prose">
          <p class="num">{x.meteors.n}</p>
          <h3>{x.meteors.title}</h3>
          {x.meteors.body.map((p) => <p>{p}</p>)}
          <table class="t-table">
            <thead><tr>{x.meteors.paramHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.meteors.params.map((r) => <tr><th scope="row"><code>{r[0]}</code></th><td>{r[1]}</td><td class="muted">{r[2]}</td></tr>)}</tbody>
          </table>
          <p class="small muted">{x.meteors.rateNote}</p>
        </div>
        <div class="media"><CodeBlock title={code.meteor.file} code={code.meteor.code} note={x.codeNote} lang="javascript" /></div>
      </div>

      <div class="row flip t-row">
        <div class="prose">
          <h3>{x.meteors.tailTitle}</h3>
          <p>{x.meteors.tailBody}</p>
          <CodeBlock title={L.fileTail} code={code.tail.code} lang="javascript" />
        </div>
        <figure class="meteor-seq">
          <figcaption class="eyebrow">{x.meteors.seqTitle}</figcaption>
          <ol role="list">
            {x.meteors.seq.map((m) => (
              <li>
                <Image src={meteorImg(m.key)} alt={`${x.meteors.seqAlt}, ${m.label.toLowerCase()} (${m.f}).`} widths={[468]} sizes="468px" />
                <span class="seq-k"><strong>{m.label}</strong><span class="muted">{m.f}</span></span>
              </li>
            ))}
          </ol>
          <p class="small muted">{x.meteors.seqNote}</p>
        </figure>
      </div>

      <!-- System: one clock, three systems -->
      <div id="tech-system" class="system">
        <h3>{x.system.title}</h3>
        <p>{x.system.body}</p>
        <div class="sysdiag" role="img" aria-label={`${x.system.control} → ${x.system.clock} → ${x.system.cols.map((col) => col.k).join(', ')} → ${x.system.result}`}>
          <div class="node ctl">{x.system.control}</div>
          <span class="down" aria-hidden="true">↓</span>
          <div class="node clock"><code>{x.system.clock}</code><span>{x.system.clockNote}</span><span class="speed">{x.system.speed}</span></div>
          <span class="down" aria-hidden="true">↓</span>
          <div class="cols3">
            {x.system.cols.map((col) => (
              <div class="col">
                <p class="col-k">{col.k}</p>
                <ul role="list">{col.items.map((it) => <li>{it}</li>)}</ul>
                <p class="col-out">↓ {col.out}</p>
              </div>
            ))}
          </div>
          <span class="down" aria-hidden="true">↓</span>
          <div class="node result">{x.system.result}</div>
        </div>
      </div>

      <!-- Notes: honest limits of the original code -->
      <div id="tech-notes" class="notes">
        <h3>{x.notes.title}</h3>
        <p>{x.notes.body}</p>
        <div class="scroll">
          <table class="t-table notes-table">
            <thead><tr>{x.notes.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{x.notes.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td><td class="muted">{r[3]}</td></tr>)}</tbody>
          </table>
        </div>
        <h3 class="refl-h">{x.reflection.title}</h3>
        <p>{x.reflection.body}</p>
      </div>
    </section>

    <!-- G · Reflection: text | quote + credits -->
    <section class="wrap block wide-text reflection" aria-labelledby="reflection-heading">
      <h2 id="reflection-heading">{c.reflection.title}</h2>
      <div class="cols">{c.reflection.body.map((p) => <p>{p}</p>)}</div>
      <blockquote><p>“{c.reflection.quote}”</p></blockquote>
      <ul class="credits" role="list">
        {c.credits.map((cr) => <li>{cr}</li>)}
      </ul>
    </section>

    <nav class="wrap bottom-nav" aria-label={L.projectNav}>
      <a class="text-link" href={page(lang, '/work/')}>← {t('project.back')}</a>
      <a class="next" href={page(lang, `/work/${next.slug}/`)}>
        <span class="eyebrow">{t('project.next')}</span>
        <span class="next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>

  .crumbs { padding-top: var(--space-3); }
