---
import Base from '../layouts/Base.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { useT, contact, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const hasSocial = Boolean(contact.linkedin || contact.facebook);
---

<Base lang={lang} route="/contact/" title={t('nav.contact')} description={t('contact.title')} footerCta={false}>
  <div class="wrap contact">
    <h1>{t('contact.title')}</h1>
    <p class="sub">{t('contact.sub')}</p>

    <dl>
      <div>
        <dt>{t('contact.email')}</dt>
        <dd><a class="mail" href={`mailto:${contact.email}`}>{contact.email} <span class="arrow" aria-hidden="true">↗</span></a></dd>
      </div>
      <div>
        <dt>{t('contact.elsewhere')}</dt>
        <dd>
          {hasSocial ? (
            <SocialIcons lang={lang} email={false} />
          ) : (
            <span class="muted">{t('contact.soon')}</span>
          )}
        </dd>
      </div>
    </dl>
  </div>
</Base>

<style>
  .contact { padding-block: var(--space-5); }
  h1 { font-size: var(--step-3); }
  .sub { margin: var(--space-2) 0 var(--space-5); color: var(--text-2); font-size: var(--step-1); }
  dl { margin: 0; border-top: 1px solid var(--line); }
  dl > div { display: grid; gap: var(--space-1) var(--space-4); padding-block: var(--space-3); border-bottom: 1px solid var(--line); }
  @media (min-width: 48rem) { dl > div { grid-template-columns: 14rem minmax(0, 1fr); } }
  dt { color: var(--text-2); font-size: var(--step--1); font-weight: 500; }
  dd { margin: 0; }
  /* The address reads as a plain link in the body face, not as a second headline. */
  dl > div { align-items: baseline; }
  .mail {
    display: inline-flex; align-items: baseline; gap: 0.35rem; min-height: 44px; align-content: center;
    font-size: var(--step-1); font-weight: 500;
    text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
    overflow-wrap: anywhere;
  }
  .mail .arrow { font-size: 0.85em; color: var(--text-2); }
  .mail:hover { color: var(--accent); text-decoration-color: currentColor; }
  .mail:hover .arrow { color: currentColor; }
  dd :global(.social) { margin: -10px 0 0 -10px; } /* optical alignment with the label */
  .muted { color: var(--text-2); }
</style>
