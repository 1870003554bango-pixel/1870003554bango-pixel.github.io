---
import Base from '../layouts/Base.astro';
import { useT, contact, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const others = [
  { label: 'LinkedIn', href: contact.linkedin },
  { label: 'Facebook', href: contact.facebook },
  { label: 'GitHub', href: contact.github },
  { label: 'Bilibili', href: contact.bilibili },
  { label: 'Douyin', href: contact.douyin },
].filter((o) => o.href);
---

<Base lang={lang} route="/contact/" title={t('nav.contact')} description={t('contact.title')}>
  <div class="wrap contact">
    <h1>{t('contact.title')}</h1>
    <p class="sub">{t('contact.sub')}</p>

    <dl>
      <div>
        <dt>{t('contact.email')}</dt>
        <dd><a class="mail" href={`mailto:${contact.email}`}>{contact.email} <span class="arrow" aria-hidden="true">↗</span></a></dd>
      </div>
      <div>
        <dt>{t('contact.elsewhere')}</dt>
        <dd>
          {others.length ? (
            <ul role="list">{others.map((o) => <li><a class="text-link" href={o.href} rel="me noopener" target="_blank">{o.label} ↗</a></li>)}</ul>
          ) : (
            <span class="muted">{t('contact.soon')}</span>
          )}
        </dd>
      </div>
    </dl>
  </div>
</Base>

<style>
  .contact { padding-block: var(--space-5); }
  h1 { font-size: var(--step-3); max-width: 16ch; }
  .sub { margin: var(--space-2) 0 var(--space-5); color: var(--text-2); font-size: var(--step-1); }
  dl { margin: 0; border-top: 1px solid var(--line); }
  dl > div { display: grid; gap: var(--space-1) var(--space-4); padding-block: var(--space-3); border-bottom: 1px solid var(--line); }
  @media (min-width: 48rem) { dl > div { grid-template-columns: 14rem minmax(0, 1fr); } }
  dt { color: var(--text-2); font-size: var(--step--1); font-weight: 500; }
  dd { margin: 0; }
  .mail { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; text-decoration: none; overflow-wrap: anywhere; }
  .mail:hover { color: var(--accent); }
  ul { display: flex; flex-wrap: wrap; gap: 0 1.5rem; margin: 0; padding: 0; list-style: none; }
  .muted { color: var(--text-2); }
</style>
