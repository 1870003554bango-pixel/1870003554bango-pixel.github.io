---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { languages, useT, contact, type Lang } from '../i18n/ui';
import { page, url } from '../lib/url';

interface Props {
  lang: Lang;
  /** Language-free route of this page, e.g. '/work/scam-ready/'. Used for the language switch. */
  route: string;
  title?: string;
  description?: string;
  image?: ImageMetadata | null;
  /** Footer "Let's talk" block. Off on Home, which has its own contact section. */
  footerCta?: boolean;
  /** Optional project palette, e.g. 'cocoa' → <html class="theme-cocoa"> (tokens in global.css). */
  theme?: string;
}

const { lang, route, title, description, image, footerCta = true, theme } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} — ${t('site.name')}` : `${t('site.name')} — Digital Media · Interactive Design`;
const desc = description ?? t('site.description');
const other: Lang = lang === 'en' ? 'zh' : 'en';

const nav = [
  { route: '/', label: t('nav.home') },
  { route: '/work/', label: t('nav.work') },
  { route: '/about/', label: t('nav.about') },
  { route: '/contact/', label: t('nav.contact') },
];
const isCurrent = (r: string) => (r === '/' ? route === '/' : route.startsWith(r));

const site = Astro.site ?? new URL('http://localhost:4321');
const abs = (p: string) => new URL(p, site).href;
const ogImage = image ? abs((await getImage({ src: image, width: 1200, format: 'jpeg' })).src) : undefined;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class={theme ? `theme-${theme}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(page(lang, route))} />
    <link rel="alternate" hreflang="en" href={abs(page('en', route))} />
    <link rel="alternate" hreflang="zh-CN" href={abs(page('zh', route))} />
    <link rel="alternate" hreflang="x-default" href={abs(page('en', route))} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={abs(page(lang, route))} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={page(lang, '/')}>{t('site.brand')}</a>

        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"
          data-open={t('nav.menu')} data-close={t('nav.close')}>
          <span class="menu-icon" aria-hidden="true"></span>
          <span class="menu-label">{t('nav.menu')}</span>
        </button>

        <nav id="site-nav" class="nav" aria-label={t('nav.label')}>
          <ul role="list">
            {nav.map((n) => (
              <li><a href={page(lang, n.route)} aria-current={isCurrent(n.route) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
          <div class="nav-end">
            {contact.resume && (
              <a class="resume" href={url(contact.resume)}>{t('nav.resume')} <span class="arrow" aria-hidden="true">↗</span></a>
            )}
            <a class="lang" href={page(other, route)} hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'}>
              <span class="sr-only">{t('lang.label')}: </span>
              <span aria-current="true" class="lang-on">{languages[lang]}</span>
              <span aria-hidden="true">/</span>
              <span>{languages[other]}</span>
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        {footerCta && (
          <div class="foot-cta">
            <p class="foot-title">{t('footer.cta')}</p>
            <a class="text-link foot-mail" href={`mailto:${contact.email}`}>{contact.email} <span class="arrow" aria-hidden="true">↗</span></a>
          </div>
        )}
        <div class="foot-row">
          <ul class="foot-nav" role="list">
            {nav.map((n) => <li><a href={page(lang, n.route)}>{n.label}</a></li>)}
            <li><a href={page(other, route)} lang={other === 'zh' ? 'zh-CN' : 'en'}>{languages[other]}</a></li>
          </ul>
          <a class="to-top" href="#main">{t('footer.top')} <span aria-hidden="true">↑</span></a>
        </div>
        <p class="rights">© {t('footer.rights')}</p>
      </div>
    </footer>

    <script>
      // Keep short titles on one line. A heading that is only a little wider than its column is
      // scaled down just enough to fit (h1 to 65% at most, others to 75%). Anything longer is a
      // genuinely long heading and wraps at its normal size. Small labels (< 22px) are left alone.
      const FIT = 'main :is(h1, h2, h3, .tagline, .next-title):not(:has(> span)), main h1 > span';
      const fitTitles = () => {
        const els = [...document.querySelectorAll<HTMLElement>(FIT)];
        for (const el of els) { el.style.fontSize = ''; el.style.whiteSpace = ''; }
        const range = document.createRange();
        for (const el of els) {
          if (!el.offsetParent && getComputedStyle(el).position !== 'fixed') continue; // hidden
          const base = parseFloat(getComputedStyle(el).fontSize);
          if (base < 22) continue;
          const cs = getComputedStyle(el);
          const avail = el.getBoundingClientRect().width - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
          el.style.whiteSpace = 'nowrap';
          range.selectNodeContents(el);
          const text = range.getBoundingClientRect().width;
          const isTitle = el.tagName === 'H1' || el.parentElement?.tagName === 'H1';
          const scale = avail / text;
          if (scale >= 1) { el.style.whiteSpace = ''; continue; }
          if (scale >= (isTitle ? 0.65 : 0.75)) el.style.fontSize = `${(base * scale * 0.99).toFixed(2)}px`;
          else el.style.whiteSpace = '';
        }
      };
      let raf = 0;
      const queue = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(fitTitles); };
      fitTitles();
      document.fonts?.ready.then(fitTitles);
      let lastW = innerWidth;
      addEventListener('resize', () => { if (innerWidth !== lastW) { lastW = innerWidth; queue(); } });
    </script>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      const nav = document.getElementById('site-nav')!;
      const label = btn.querySelector('.menu-label')!;
      const set = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('open', open);
        label.textContent = open ? btn.dataset.close! : btn.dataset.open!;
      };
      btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); btn.focus(); }
      });
      matchMedia('(min-width: 48rem)').addEventListener('change', () => set(false));
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 450;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav { display: flex; align-items: center; gap: var(--space-3); }
  .nav ul { display: flex; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .nav a { text-decoration: none; }
  .nav ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    color: var(--text-2);
    font-size: var(--step--1);
    font-weight: 500;
  }
  .nav ul a:hover, .nav ul a[aria-current='page'] { color: var(--text); }
  .nav ul a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.5em; }
  .nav-end { display: flex; align-items: center; gap: var(--space-2); }
  .lang, .resume {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-2);
  }
  .lang-on { color: var(--text); font-weight: 600; }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
  }
  .menu-icon, .menu-icon::before {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--dur-hover) var(--ease-out);
  }
  .menu-icon { position: relative; transform: translateY(-3px); }
  .menu-icon::before { content: ''; position: absolute; top: 6px; }
  .menu-btn[aria-expanded='true'] .menu-icon { transform: translateY(0) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .menu-icon::before { transform: translateY(-6px) rotate(-90deg); }

  @media (max-width: 47.99rem) {
    .menu-btn { display: inline-flex; }
    .nav {
      display: none;
      position: absolute;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-1) var(--gutter) var(--space-3);
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .nav.open { display: flex; }
    /* Overlay family: the mobile menu drops in from under the header. */
    .nav { transition: opacity var(--dur-swap) var(--ease-out), transform var(--dur-swap) var(--ease-out); }
    @starting-style { .nav.open { opacity: 0; transform: translateY(-8px); } }
    .nav ul { flex-direction: column; }
    .nav ul a { padding-inline: 0; font-size: var(--step-1); color: var(--text); width: 100%; }
    .nav-end { padding-top: var(--space-1); border-top: 1px solid var(--line); margin-top: var(--space-1); }
    .lang { padding-inline: 0; }
  }

  .site-footer {
    margin-top: var(--space-6);
    padding-block: var(--space-5) var(--space-3);
    border-top: 1px solid var(--line);
  }
  .foot-cta { padding-bottom: var(--space-4); }
  .foot-title { margin: 0 0 var(--space-1); font-family: var(--font-display); font-size: var(--step-2); font-weight: 400; letter-spacing: -0.01em; }
  .foot-mail { font-size: var(--step-1); }
  .foot-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .foot-nav { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin: 0; padding: 0; list-style: none; }
  .foot-nav a, .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    font-size: var(--step--1);
    color: var(--text-2);
    text-decoration: none;
  }
  .foot-nav a:hover, .to-top:hover { color: var(--text); }
  .rights { margin: var(--space-1) 0 0; font-size: var(--step--1); color: var(--text-2); }
</style>
