---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'work'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary}>
  <article>
    <p class="back"><a href={url('/')}>← 全部作品</a></p>
    <header class="head">
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <dl class="facts">
        <div><dt>时间</dt><dd>{d.year}</dd></div>
        <div><dt>角色</dt><dd>{d.role}</dd></div>
        <div><dt>工具</dt><dd>{d.tools.join(' · ')}</dd></div>
        <div><dt>类型</dt><dd>{d.type}</dd></div>
      </dl>
    </header>
    {d.cover && (
      <Image class="cover" src={d.cover} alt={d.coverAlt ?? ''} widths={[960, 1600, 2400]} sizes="(min-width: 72rem) 72rem, 100vw" />
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back { margin: var(--space-2) 0 var(--space-3); font-size: var(--step--1); }
  .back a { display: inline-flex; min-height: 44px; align-items: center; color: var(--text-muted); }
  .head { max-width: var(--measure); margin-bottom: var(--space-4); }
  .head h1 { font-size: var(--step-3); margin: 0 0 var(--space-2); }
  .summary { font-size: var(--step-1); margin: 0 0 var(--space-3); }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .facts dt { font-size: var(--step--1); color: var(--text-muted); }
  .facts dd { margin: 0; }
  .cover { width: 100%; height: auto; border-radius: 4px; margin-bottom: var(--space-4); }
</style>
