---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ReadingPanel from '../components/ReadingPanel.astro';
import Ticker from '../components/Ticker.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const { hero } = site;
---

<Base>
  <section class="hero wrap">
    <h1>
      {hero.before}<span class="mark">{hero.highlight}<svg viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M3 15 C 40 7, 85 5, 128 8 S 186 14, 197 9 M 12 19 C 60 13, 120 12, 170 16" />
        </svg></span>{hero.after}
    </h1>
    <p class="sub">{hero.sub}</p>
    <p class="signature">{hero.signature}</p>
  </section>

  <section class="settings wrap" aria-label="阅读设置">
    <ReadingPanel />
  </section>

  <Ticker items={site.ticker} />

  <section class="tools wrap" aria-labelledby="tools-title">
    <h2 id="tools-title" class="eyebrow">常用工具</h2>
    <ul role="list">
      {site.tools.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <section class="featured" aria-labelledby="work-title">
    <div class="wrap">
      <header>
        <h2 id="work-title">精选作品</h2>
        <p>每个项目都从一个问题出发，附带完整的过程记录。</p>
      </header>
      <ol class="grid" role="list">
        {work.map((item) => (
          <li><WorkCard item={item} /></li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) var(--space-4);
    text-align: center;
  }
  .hero h1 {
    max-width: 19em;
    margin: 0 auto var(--space-3);
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1.28;
    letter-spacing: -0.02em;
  }
  .mark { position: relative; white-space: nowrap; }
  .mark svg {
    position: absolute;
    left: -6%;
    bottom: -0.32em;
    width: 112%;
    height: 0.5em;
    overflow: visible;
  }
  .mark path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .sub {
    max-width: 34em;
    margin: 0 auto var(--space-2);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .signature {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.35rem;
    color: var(--text-muted);
  }

  .settings { padding-block: var(--space-2) var(--space-5); }

  .tools {
    padding-block: var(--space-4);
    text-align: center;
  }
  .tools h2 { margin: 0 0 var(--space-2); }
  .tools ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .featured {
    background: var(--band);
    padding-block: var(--space-5) var(--space-6);
  }
  .featured header { text-align: center; margin-bottom: var(--space-4); }
  .featured h2 { margin: 0 0 0.4rem; font-size: var(--step-2); font-weight: 400; }
  .featured header p { margin: 0; color: var(--text-muted); font-size: var(--step--1); }

  .grid {
    display: grid;
    gap: var(--space-3);
    max-width: 58rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-3); align-items: start; }
    .grid li:nth-child(even) { margin-top: var(--space-5); }
    .grid li:nth-child(odd):not(:first-child) { margin-top: calc(var(--space-5) * -1 + var(--space-3)); }
  }
</style>
