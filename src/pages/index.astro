---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <section class="intro">
    <h1>待补充：一句话介绍你自己。</h1>
    <p class="lede">待补充：你做什么、关注什么。</p>
  </section>

  <section aria-labelledby="work-heading">
    <h2 id="work-heading" class="section-label">精选作品</h2>
    <ol class="work-list" role="list">
      {work.map((item) => (
        <li>
          <a class="work-item" href={url(`/work/${item.id}`)}>
            {item.data.cover ? (
              <Image src={item.data.cover} alt={item.data.coverAlt ?? ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 40vw, 100vw" />
            ) : (
              <div class="cover-placeholder" aria-hidden="true">封面待补充</div>
            )}
            <div class="meta">
              <h3>{item.data.title}</h3>
              <p class="summary">{item.data.summary}</p>
              <p class="facts">{item.data.type} · {item.data.year}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .intro { padding-block: var(--space-4) var(--space-5); max-width: 40rem; }
  .intro h1 { font-size: var(--step-3); margin: 0 0 var(--space-2); }
  .lede { font-size: var(--step-1); color: var(--text-muted); margin: 0; }

  .section-label {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
  }
  .work-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); }

  .work-item {
    display: grid;
    gap: var(--space-2) var(--space-4);
    text-decoration: none;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .work-item { grid-template-columns: 5fr 4fr; align-items: start; }
  }
  .work-item img, .cover-placeholder { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 4px; }
  .cover-placeholder {
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px dashed var(--line);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .meta h3 { font-size: var(--step-2); margin: 0 0 var(--space-1); }
  .work-item:hover h3 { color: var(--accent); }
  .summary { margin: 0 0 var(--space-1); }
  .facts { margin: 0; color: var(--text-muted); font-size: var(--step--1); }
</style>
