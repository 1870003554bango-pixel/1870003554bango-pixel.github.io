---
// Real cover image, or a clearly labelled placeholder when the material isn't in yet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata | null;
  alt: string;
  ratio: string;
  widths: number[];
  sizes: string;
  todo: string;
  loading?: 'lazy' | 'eager';
}
const { image, alt, ratio, widths, sizes, todo, loading = 'lazy' } = Astro.props;
---

{image ? (
  <Image class="cover" src={image} alt={alt} widths={widths} sizes={sizes} loading={loading} style={`aspect-ratio: ${ratio}`} />
) : (
  <div class="placeholder cover" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`TODO: ${todo}`}>
    <span><strong>TODO</strong><br />{todo}</span>
  </div>
)}

<style>
  .cover { width: 100%; height: auto; object-fit: cover; border-radius: var(--radius); }
</style>
