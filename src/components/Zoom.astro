---
// An image that opens larger in the page's <Lightbox />. Put <Lightbox /> once per page.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fit?: 'cover' | 'contain';
  ratio?: string;
}
const { src, alt, caption, widths = [400, 800, 1200], sizes = '(min-width: 48rem) 50vw, 100vw', class: cls, loading = 'lazy', fit, ratio } = Astro.props;
const large = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
const style = [ratio && `aspect-ratio: ${ratio}`, fit && `object-fit: ${fit}`].filter(Boolean).join('; ');
---

<figure class:list={['zoom', cls]}>
  <button type="button" class="zoom-btn" data-zoom={large.src} data-zoom-alt={alt} data-zoom-caption={caption ?? ''} aria-label={`${Astro.url.pathname.includes('/zh/') ? '放大图片：' : 'Enlarge image: '}${alt}`}>
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} style={style || undefined} />
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .zoom { margin: 0; display: grid; gap: 0.4rem; min-width: 0; }
  .zoom-btn { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: var(--radius); }
  .zoom-btn :global(img) { display: block; width: 100%; height: auto; border-radius: var(--radius); }
  .zoom figcaption { font-size: var(--step--1); color: var(--text-2); line-height: 1.4; }
</style>
