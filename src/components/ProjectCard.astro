---
import Cover from './Cover.astro';
import { useT, type Lang } from '../i18n/ui';
import { page } from '../lib/url';
import type { Project } from '../data/projects';

interface Props { project: Project; lang: Lang; headingLevel?: 'h2' | 'h3'; index?: number }
const { project: p, lang, headingLevel = 'h3', index } = Astro.props;
const t = useT(lang);
const H = headingLevel;
---

<a class="card" href={page(lang, `/work/${p.slug}/`)}>
  <div class="media">
    <Cover image={p.cover} alt={p.cover ? p.coverAlt[lang] : ''} ratio="4 / 3" widths={[480, 800, 1200]}
      sizes="(min-width: 48rem) 560px, 100vw" todo={t('project.coverTodo')} fit={p.coverFit} />
  </div>
  <div class="text">
    <p class="meta">
      {index !== undefined && <span class="num">{String(index).padStart(2, '0')}</span>}
      <span>{p.type[lang]}</span>
    </p>
    <H class="title">{p.title}</H>
    <p class="desc">{(p.summary ?? p.subtitle)[lang]}</p>
    {p.tools.length > 0 && <p class="tools">{p.tools.join(' · ')}</p>}
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: var(--space-2); text-decoration: none; color: inherit; border-radius: var(--radius); }
  .card:focus-visible { outline-offset: 6px; }
  .media { position: relative; overflow: hidden; border-radius: var(--radius); }
  .media :global(.cover) { transition: transform var(--dur-page) var(--ease-out); }
  .card:hover .media :global(img) { transform: scale(1.02); }


  .text { display: grid; gap: 0.4rem; }
  .meta { display: flex; gap: 0.75rem; margin: 0; font-size: var(--step--1); color: var(--text-2); }
  .num { font-variant-numeric: tabular-nums; color: var(--text); font-weight: 500; }
  .title { font-family: var(--font-display); font-size: clamp(1.5rem, 0.8vw + 1.1rem, 1.875rem); font-weight: 400; letter-spacing: -0.01em; line-height: 1.15; }
  .card:hover .title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .desc { margin: 0; max-width: 58ch; }
  .tools { margin: 0; font-size: var(--step--1); color: var(--text-2); }
</style>
