---
import Cover from './Cover.astro';
import { useT, type Lang } from '../i18n/ui';
import { page } from '../lib/url';
import type { Project } from '../data/projects';

interface Props { project: Project; lang: Lang; headingLevel?: 'h2' | 'h3' }
const { project: p, lang, headingLevel = 'h3' } = Astro.props;
const t = useT(lang);
const H = headingLevel;
---

<a class="card" href={page(lang, `/work/${p.slug}/`)}>
  <div class="media">
    <Cover image={p.cover} alt="" ratio="4 / 3" widths={[480, 800, 1200]} sizes="(min-width: 48rem) 560px, 100vw" todo={t('project.coverTodo')} />
  </div>
  <div class="text">
    <p class="type">{p.type[lang]}</p>
    <H class="title">{p.title} <span class="arrow" aria-hidden="true">↗</span></H>
    <p class="sub">{p.subtitle[lang]}</p>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: var(--space-2); text-decoration: none; color: inherit; }
  .media { overflow: hidden; border-radius: var(--radius); }
  .media :global(.cover) { transition: transform 300ms ease-out; }
  .card:hover .media :global(img) { transform: scale(1.02); }
  .text { display: grid; gap: 0.35rem; }
  .type { margin: 0; font-size: var(--step--1); color: var(--text-2); }
  .title { font-size: var(--step-1); font-weight: 600; }
  .card:hover .title { color: var(--accent); }
  .title .arrow { margin-left: 0.2em; }
  .card:hover .arrow { transform: translate(2px, -2px); }
  .sub { margin: 0; color: var(--text-2); max-width: 46ch; }
</style>
