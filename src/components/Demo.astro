---
// Click-to-run embed for p5 sketches and web demos in public/.
// Shows the poster first so the page stays fast; the iframe loads only on click.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url';

interface Props {
  src: string;
  label: string;
  ratio: string;
  poster?: ImageMetadata;
  title: string;
}
const { src, label, ratio, poster, title } = Astro.props;
const full = url(src);
---

<figure class="demo" style={`--ratio: ${ratio}`} data-src={full} data-title={title}>
  <div class="stage">
    {poster && <Image src={poster} alt="" widths={[800, 1400, 2000]} sizes="(min-width: 70rem) 70rem, 100vw" />}
    <button type="button" class="run">
      <span class="play" aria-hidden="true">▶</span>{label}
    </button>
  </div>
  <figcaption>
    <span>点击后加载，可能会播放声音。</span>
    <a href={full} target="_blank" rel="noopener">在新窗口打开 <span aria-hidden="true">↗</span></a>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.demo').forEach((fig) => {
    fig.querySelector('.run')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = fig.dataset.src!;
      frame.title = fig.dataset.title!;
      frame.allow = 'autoplay; fullscreen';
      const stage = fig.querySelector('.stage')!;
      stage.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .demo { margin: 0 0 var(--space-4); }
  .stage {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--band);
    border: 1px solid var(--line);
  }
  .stage :global(img), .stage :global(iframe) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .run {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0 1.3rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: transform 200ms ease-out;
  }
  .run:hover { transform: translate(-50%, -50%) scale(1.03); }
  .play { font-size: 0.75em; }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1);
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  figcaption a { display: inline-flex; align-items: center; min-height: 44px; margin-block: -0.7rem; color: var(--text); }
</style>
