---
// Click-to-run embed for p5 sketches and web demos in public/demos/.
// Shows the poster first so the page stays light; the iframe loads only on click.
import Cover from './Cover.astro';
import type { ImageMetadata } from 'astro';
import { useT, type Lang } from '../i18n/ui';
import { url } from '../lib/url';

interface Props {
  src: string;
  ratio: string;
  poster: ImageMetadata | null;
  title: string;
  lang: Lang;
}
const { src, ratio, poster, title, lang } = Astro.props;
const t = useT(lang);
const full = url(src);
---

<figure class="demo" data-src={full} data-title={title}>
  <div class="stage" style={`aspect-ratio: ${ratio}`}>
    <Cover image={poster} alt="" ratio={ratio} widths={[800, 1400, 2000]} sizes="(min-width: 75rem) 1072px, 100vw" todo={t('project.coverTodo')} />
    <button type="button" class="btn btn-primary run">
      <span aria-hidden="true">▶</span>{t('project.runDemo')}
    </button>
  </div>
  <figcaption>
    <span>{t('project.demoNote')}</span>
    <a class="text-link" href={full} target="_blank" rel="noopener">{t('project.fullscreen')} <span class="arrow" aria-hidden="true">↗</span></a>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.demo').forEach((fig) => {
    fig.querySelector('.run')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = fig.dataset.src!;
      frame.title = fig.dataset.title!;
      frame.allow = 'autoplay; fullscreen';
      fig.querySelector('.stage')!.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .demo { margin: 0; }
  .stage {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--sunken);
  }
  .stage :global(iframe) { width: 100%; height: 100%; border: 0; }
  .run {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    margin-top: 0.5rem;
    color: var(--text-2);
    font-size: var(--step--1);
  }
</style>
