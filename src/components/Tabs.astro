---
// Accessible tabs (ARIA tablist): click or Left/Right/Home/End. Each panel = real image + short text.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Tab { id: string; label: string; title: string; text: string; src: ImageMetadata; alt: string }
interface Props { tabs: Tab[]; label: string }
const { tabs, label } = Astro.props;
const uid = `tabs-${tabs.map((t) => t.id).join('').slice(0, 12)}`;
---

<div class="tabs" data-tabs>
  <div class="list" role="tablist" aria-label={label}>
    {tabs.map((t, i) => (
      <button type="button" role="tab" id={`${uid}-tab-${t.id}`} aria-controls={`${uid}-panel-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="n">{String(i + 1).padStart(2, '0')}</span>{t.label}
      </button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <div class="panel swap" role="tabpanel" id={`${uid}-panel-${t.id}`} aria-labelledby={`${uid}-tab-${t.id}`} hidden={i !== 0} tabindex="0">
      <Image src={t.src} alt={t.alt} widths={[270, 540]} sizes="200px" />
      <div>
        <h4>{t.title}</h4>
        <p>{t.text}</p>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
        panels[j].hidden = j !== i;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % n, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + n) % n, true); }
        if (e.key === 'Home') { e.preventDefault(); select(0, true); }
        if (e.key === 'End') { e.preventDefault(); select(n - 1, true); }
      });
    });
  });
</script>

<style>
  .tabs { display: grid; gap: var(--space-2); }
  .list { display: flex; flex-wrap: wrap; gap: 0.25rem; border-bottom: 1px solid var(--line); }
  [role='tab'] {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--text-2);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 500;
    cursor: pointer;
  }
  [role='tab']:hover { color: var(--text); }
  [role='tab'][aria-selected='true'] { color: var(--text); border-bottom-color: var(--accent); }
  .n { font-variant-numeric: tabular-nums; color: var(--accent); font-size: 0.75rem; }
  .panel { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: var(--space-3); align-items: center; }
  .panel :global(img) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); }
  .panel h4 { margin: 0 0 0.35rem; font-size: var(--step-1); font-weight: 600; }
  .panel p { margin: 0; }
</style>
