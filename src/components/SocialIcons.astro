---
// LinkedIn / Facebook / email icon links (44px targets). Used on Home and Contact.
import { useT, contact, type Lang } from '../i18n/ui';
interface Props { lang: Lang; email?: boolean }
const { lang, email = true } = Astro.props;
const t = useT(lang);
---

<ul class="social" role="list">
  {contact.linkedin && (
    <li><a href={contact.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm7 0h3.8v1.6h.06c.53-1 1.83-2.05 3.76-2.05 4.02 0 4.76 2.5 4.76 5.75V21h-4v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21h-4V9.75Z"/></svg>
    </a></li>
  )}
  {contact.facebook && (
    <li><a href={contact.facebook} target="_blank" rel="me noopener" aria-label="Facebook">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.6h2.55l.4-3h-2.95V8.5c0-.86.25-1.45 1.5-1.45h1.6V4.37A21 21 0 0 0 14.27 4.2c-2.3 0-3.87 1.4-3.87 3.97v2.23H7.8v3h2.6V21h3.1Z"/></svg>
    </a></li>
  )}
  {email && <li><a href={`mailto:${contact.email}`} aria-label={`${t('contact.email')}: ${contact.email}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18a1 1 0 0 1 1 1V18a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18V6.5a1 1 0 0 1 1-1Zm1 2.3v.2l8 5.3 8-5.3v-.2H4Z"/></svg>
  </a></li>}
</ul>

<style>
  .social { display: flex; gap: 0.5rem; margin: var(--space-2) 0 0; padding: 0; list-style: none; }
  .social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--text); transition: background var(--dur-hover) var(--ease-out); }
  .social a:hover { background: var(--sunken); }
  .social svg { width: 22px; height: 22px; fill: currentColor; }
  @media (prefers-reduced-motion: reduce) { .social a { transition: none; } }
</style>
